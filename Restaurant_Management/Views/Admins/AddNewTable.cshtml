@using Restaurant_Management.ViewModels.Admins
@{
    Layout = null;
    @model AddNewTableViewModel
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Add New Table - BistroPro</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-tertiary-fixed-variant": "#7b2f00",
                      "on-tertiary": "#ffffff",
                      "on-secondary": "#ffffff",
                      "background": "#fcf8ff",
                      "error": "#ba1a1a",
                      "tertiary-fixed-dim": "#ffb695",
                      "secondary": "#505f76",
                      "secondary-fixed-dim": "#b7c8e1",
                      "primary-fixed": "#e2dfff",
                      "on-secondary-fixed": "#0b1c30",
                      "inverse-primary": "#c3c0ff",
                      "tertiary-fixed": "#ffdbcc",
                      "on-surface": "#1b1b24",
                      "primary-fixed-dim": "#c3c0ff",
                      "on-tertiary-fixed": "#351000",
                      "outline-variant": "#c7c4d8",
                      "secondary-fixed": "#d3e4fe",
                      "primary-container": "#4f46e5",
                      "on-surface-variant": "#464555",
                      "on-error-container": "#93000a",
                      "inverse-on-surface": "#f3effc",
                      "surface-container-lowest": "#ffffff",
                      "on-primary": "#ffffff",
                      "surface": "#fcf8ff",
                      "on-secondary-fixed-variant": "#38485d",
                      "on-primary-fixed": "#0f0069",
                      "surface-dim": "#dcd8e5",
                      "tertiary-container": "#a44100",
                      "secondary-container": "#d0e1fb",
                      "on-error": "#ffffff",
                      "on-background": "#1b1b24",
                      "primary": "#3525cd",
                      "surface-variant": "#e4e1ee",
                      "tertiary": "#7e3000",
                      "on-secondary-container": "#54647a",
                      "surface-container-highest": "#e4e1ee",
                      "error-container": "#ffdad6",
                      "on-tertiary-container": "#ffd2be",
                      "surface-container-high": "#eae6f4",
                      "surface-tint": "#4d44e3",
                      "surface-container": "#f0ecf9",
                      "surface-container-low": "#f5f2ff",
                      "surface-bright": "#fcf8ff",
                      "outline": "#777587",
                      "inverse-surface": "#302f39",
                      "on-primary-fixed-variant": "#3323cc",
                      "on-primary-container": "#dad7ff"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "gutter": "24px",
                      "container-margin-mobile": "16px",
                      "sidebar-width": "280px",
                      "container-margin-desktop": "32px",
                      "base": "8px"
              },
              "fontFamily": {
                      "label-md": ["Inter"],
                      "headline-md": ["Inter"],
                      "headline-lg": ["Inter"],
                      "headline-lg-mobile": ["Inter"],
                      "label-sm": ["Inter"],
                      "body-md": ["Inter"],
                      "body-lg": ["Inter"],
                      "display-lg": ["Inter"]
              },
              "fontSize": {
                      "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                      "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                      "headline-lg": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                      "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}],
                      "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                      "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "display-lg": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
              }
            },
          },
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        input:focus {
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
        }
    </style>
    <style>
        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>
<body class="bg-background text-on-background min-h-screen flex flex-col">
    <!-- Top Navigation Bar (Contextual Header) -->
    <header class="bg-surface flex items-center justify-between h-16 px-container-margin-mobile w-full z-10 border-b border-outline-variant">
        <div class="flex items-center gap-4">
            <button class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-surface-container-high transition-colors active:opacity-80">
                <span class="material-symbols-outlined text-on-surface">close</span>
            </button>
            <h1 class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-on-surface">New Table</h1>
        </div>
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">table_restaurant</span>
        </div>
    </header>
    <!-- Main Content Canvas -->
    <main class="flex-1 overflow-y-auto px-container-margin-mobile py-8 max-w-md mx-auto w-full">
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
            <form method="post" asp-action="AddNewTable" class="flex flex-col gap-8" id="addTableForm">
                @Html.AntiForgeryToken()
                <!-- Table Number Field -->
                <div class="flex flex-col gap-2">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="table_number">Table Number</label>
                    <div class="relative">
                        <input asp-for="@Model.TableNumber" class="w-full bg-white border border-outline rounded-lg px-4 py-3 font-body-lg text-body-lg focus:outline-none focus:border-primary transition-all text-on-surface" id="table_number" placeholder="e.g. T-12" type="text" />
                        <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline-variant">tag</span>
                    </div>
                </div>
                <!-- Seating Capacity (Segmented Picker) -->
                <div class="flex flex-col gap-3">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider">Seating Capacity</label>
                    <div class="grid grid-cols-4 gap-2">
                        <label class="relative cursor-pointer group">
                            <input checked="" class="peer sr-only" asp-for="@Model.SeatingCapacity" type="radio" value="2" />
                            <div class="flex flex-col items-center justify-center py-4 border border-outline rounded-lg peer-checked:bg-secondary-container peer-checked:border-primary peer-checked:text-on-secondary-container hover:bg-surface-container transition-all group-active:scale-95">
                                <span class="font-headline-md text-headline-md">2</span>
                                <span class="font-label-sm text-label-sm opacity-70">Seats</span>
                            </div>
                        </label>
                        <label class="relative cursor-pointer group">
                            <input class="peer sr-only" asp-for="@Model.SeatingCapacity" type="radio" value="4" />
                            <div class="flex flex-col items-center justify-center py-4 border border-outline rounded-lg peer-checked:bg-secondary-container peer-checked:border-primary peer-checked:text-on-secondary-container hover:bg-surface-container transition-all group-active:scale-95">
                                <span class="font-headline-md text-headline-md">4</span>
                                <span class="font-label-sm text-label-sm opacity-70">Seats</span>
                            </div>
                        </label>
                        <label class="relative cursor-pointer group">
                            <input class="peer sr-only" asp-for="@Model.SeatingCapacity" type="radio" value="6" />
                            <div class="flex flex-col items-center justify-center py-4 border border-outline rounded-lg peer-checked:bg-secondary-container peer-checked:border-primary peer-checked:text-on-secondary-container hover:bg-surface-container transition-all group-active:scale-95">
                                <span class="font-headline-md text-headline-md">6</span>
                                <span class="font-label-sm text-label-sm opacity-70">Seats</span>
                            </div>
                        </label>
                        <label class="relative cursor-pointer group">
                            <input class="peer sr-only" asp-for="@Model.SeatingCapacity" type="radio" value="8" />
                            <div class="flex flex-col items-center justify-center py-4 border border-outline rounded-lg peer-checked:bg-secondary-container peer-checked:border-primary peer-checked:text-on-secondary-container hover:bg-surface-container transition-all group-active:scale-95">
                                <span class="font-headline-md text-headline-md">8+</span>
                                <span class="font-label-sm text-label-sm opacity-70">Seats</span>
                            </div>
                        </label>
                    </div>
                </div>
                <!-- Extra Options (Visual Flourish) -->
                <div class="flex items-center justify-between py-2">
                    <div class="flex flex-col">
                        <span class="font-body-md text-body-md font-medium text-on-surface">Active on Save</span>
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Available for booking immediately</span>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input asp-for = "@Model.IsAvailable" checked="" class="sr-only peer" type="checkbox" value="" />
                        <div class="w-11 h-6 bg-surface-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>

                <div class="mt-8 mb-12">
                    <button class="w-full bg-primary text-on-primary py-4 rounded-xl font-headline-md text-headline-md shadow-lg active:scale-95 transition-all hover:bg-primary-container" form="addTableForm" type="submit">
                        Save Table
                    </button>
                    <p class="text-center mt-4 font-label-md text-label-md text-on-surface-variant">
                        You can edit floor layouts in <span class="text-primary font-bold">Settings</span>
                    </p>
                </div>

            </form>
        </div>
        </main>    
    <script>
        // Simple Interaction: Mock success state
                // Submit Loading State
        document.getElementById('addTableForm').addEventListener('submit', function () {

            const submitBtn = document.querySelector('button[type="submit"]');

            submitBtn.disabled = true;

            submitBtn.innerHTML = `
                <div class="flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined animate-spin">
                        sync
                    </span>
                    Saving...
                </div>
            `;
        });

        // Input Focus Effect
        const inputs = document.querySelectorAll('input[type="text"]');

        inputs.forEach(input => {

            const icon = input.parentElement.querySelector('.material-symbols-outlined');

            if (!icon) return;

            input.addEventListener('focus', () => {
                icon.classList.add('text-primary');
            });

            input.addEventListener('blur', () => {
                icon.classList.remove('text-primary');
            });
        });

    </script>
</body>
</html>