                scale-98
                active:scale-95">

                <span class="material-symbols-outlined"
                      data-icon="book_online">

                    book_online

                </span>

                <span class="font-label-md
                    text-label-md">

                    Reservations

                </span>

            </a>


            <!-- Tables -->

            <a href="/Admins/Tables"
               class="flex items-center gap-3
                px-4 py-3
                rounded-lg
                text-on-surface-variant
                hover:bg-surface-container-highest
                transition-all duration-200
                scale-98
                active:scale-95">

                <span class="material-symbols-outlined"
                      data-icon="table_restaurant">

                    table_restaurant

                </span>

                <span class="font-label-md
                    text-label-md">

                    Tables

                </span>

            </a>


            <!-- Schedule - Active -->

            <a href="/Admins/Schedule"
               class="flex items-center gap-3
                px-4 py-3
                rounded-lg
                bg-secondary-container
                text-on-secondary-container
                border-l-4 border-primary
                font-bold
                transition-all duration-200
                scale-98
                active:scale-95">

                <span class="material-symbols-outlined"
