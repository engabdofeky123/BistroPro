            </div>

        </header>



        <!-- ================================================= -->
        <!-- PAGE CONTENT -->
        <!-- ================================================= -->

        <section id="scheduleContainer"
                 class="p-container-margin-desktop
            flex-1
            flex flex-col
            gap-gutter
            max-w-[1440px]">


            <!-- PAGE HEADER -->

            <div class="flex flex-col
                md:flex-row
                md:items-end
                justify-between
                gap-4">


                <div>

                    <h2 class="font-headline-lg
                        text-headline-lg
                        text-on-surface
                        mb-1">

                        Daily Schedule

                    </h2>

                    <p class="text-on-surface-variant
                        font-body-md">

                        Manage seatings and reservations for the selected date.

                    </p>

                </div>


                <!-- DATE NAVIGATION -->

                <div class="flex items-center gap-3
                    bg-white
                    p-1.5
                    rounded-xl
                    border border-outline-variant
                    shadow-sm">


                    <!-- PREVIOUS DAY -->

                    <button id="previousDay"
                            type="button"
                            class="material-symbols-outlined
                        p-2
                        hover:bg-surface-container
                        rounded-lg
                        transition-colors">

                        chevron_left

                    </button>


                    <!-- DATE -->

                    <div class="flex items-center
                        gap-2
                        px-4">

                        <span class="material-symbols-outlined
                            text-primary">

                            calendar_today

                        </span>

                        <span id="selectedDate"
                              class="font-label-md
                            text-label-md
                            text-on-surface">

                            @(Model.Reservations?
                                .FirstOrDefault()?
                                .ReservationDate
                                .ToString("dddd, MMMM dd, yyyy"))

                        </span>

                    </div>


                    <!-- NEXT DAY -->

                    <button id="nextDay"
                            type="button"
                            class="material-symbols-outlined
                        p-2
                        hover:bg-surface-container
                        rounded-lg
                        transition-colors">

                        chevron_right

                    </button>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- STATS -->
            <!-- ================================================= -->

            <div class="grid grid-cols-1
                md:grid-cols-2
                gap-gutter">


                <!-- TOTAL GUESTS -->

                <div class="bg-white
                    p-6
                    rounded-xl
                    border border-outline-variant
                    shadow-sm">

                    <p class="text-label-md
                        text-label-md
                        text-on-surface-variant
                        mb-2">

                        TOTAL GUESTS

                    </p>

                    <div class="flex items-baseline gap-2">

                        <span id="totalGuests"
                              class="font-display-lg
                            text-[32px]
                            text-on-surface">

                            @Model.TotalGuests

                        </span>

                        <span id="statsDateText"
                              class="text-on-surface-variant
                            text-sm
                            font-medium">

                            Selected Day

                        </span>

                    </div>

                </div>


                <!-- TOTAL RESERVATIONS -->

                <div class="bg-white
                    p-6
                    rounded-xl
                    border border-outline-variant
                    shadow-sm">

                    <p class="text-label-md
                        text-label-md
                        text-on-surface-variant
                        mb-2">

                        RESERVATIONS

                    </p>

                    <div class="flex items-baseline gap-2">

                        <span id="totalReservations"
                              class="font-display-lg
                            text-[32px]
                            text-on-surface">

                            @Model.TotalReservations

                        </span>

                        <span class="text-on-surface-variant
                            text-sm
                            font-medium">

                            Selected Day

                        </span>

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- RESERVATIONS TABLE -->
            <!-- ================================================= -->

            <div class="bg-white
                rounded-xl
                border border-outline-variant
                shadow-sm
                overflow-hidden
                flex flex-col">


                <!-- TABLE HEADER -->

                <div class="grid grid-cols-6
                    px-6 py-4
                    bg-surface-container-low
                    border-b border-outline-variant">

                    <div class="font-label-md
                        text-label-md
                        text-on-surface-variant">

                        TIME

                    </div>

                    <div class="col-span-2
                        font-label-md
                        text-label-md
                        text-on-surface-variant">

                        CUSTOMER NAME

                    </div>

                    <div class="font-label-md
                        text-label-md
                        text-on-surface-variant">

                        TABLE NO.

                    </div>

                    <div class="font-label-md
                        text-label-md
                        text-on-surface-variant">

                        GUESTS

                    </div>

                    <div class="font-label-md
                        text-label-md
                        text-on-surface-variant
                        text-right">

                        STATUS

                    </div>

                </div>


                <!-- TABLE BODY -->

                <div id="reservationsBody"
                     class="divide-y divide-outline-variant">

                    @if (Model.Reservations == null ||
                         !Model.Reservations.Any())
                    {

                        <div class="px-6 py-12
                            text-center
                            text-on-surface-variant">

                            <span class="material-symbols-outlined
                                text-4xl
                                mb-3">

                                event_busy

                            </span>

                            <p class="font-semibold">

                                No reservations for this day.

                            </p>

                            <p class="text-sm mt-1">

                                There are no reservations scheduled for this day.

                            </p>

                        </div>

                    }
                    else
                    {

                        foreach (var item in Model.Reservations)
                        {

                            var statusClass =
                                item.Status.ToString() switch
                                {
                                    "Confirmed" =>
                                        "bg-emerald-100 text-emerald-800",

                                    "Pending" =>
                                        "bg-yellow-100 text-yellow-800",

                                    "Completed" =>
                                        "bg-blue-100 text-blue-800",

                                    "Cancelled" =>
                                        "bg-red-100 text-red-800",

                                    _ =>
                                        "bg-gray-100 text-gray-800"
                                };


                            var initials = "NA";


                            if (!string.IsNullOrWhiteSpace(item.CustomerName))
                            {

                                var nameParts =
                                    item.CustomerName
                                        .Split(
                                            ' ',
                                            StringSplitOptions.RemoveEmptyEntries
                                        );


                                initials =
                                    string.Concat(
                                        nameParts
                                            .Take(2)
                                            .Select(x => x[0])
                                    ).ToUpper();

                            }


                            <div class="schedule-row
                                grid grid-cols-6
                                px-6 py-5
                                hover:bg-surface-container-lowest
                                transition-colors
                                items-center
                                group">


                                <!-- TIME -->

                                <div class="flex flex-col">

                                    <span class="font-headline-md
                                        text-[16px]
                                        text-on-surface">

                                        @item.ReservationDate.ToString("hh:mm tt")

                                    </span>

                                </div>


                                <!-- CUSTOMER -->

                                <div class="col-span-2
                                    flex items-center gap-3">

                                    <div class="w-8 h-8
                                        rounded-full
                                        bg-secondary-container
                                        flex items-center
                                        justify-center
                                        text-primary
                                        font-bold
                                        text-xs">

                                        @initials

                                    </div>

                                    <span class="font-body-md
                                        font-semibold
                                        text-on-surface">

                                        @item.CustomerName

                                    </span>

                                </div>


                                <!-- TABLE -->

                                <div>

                                    <span class="px-2 py-1
                                        bg-surface-container
                                        rounded
                                        font-label-md
                                        text-label-md
                                        text-on-surface">

                                        @item.TableNumber

                                    </span>

                                </div>


                                <!-- GUESTS -->

                                <div class="flex items-center gap-1">

                                    <span class="material-symbols-outlined
                                        text-[18px]
                                        text-on-surface-variant">

                                        person

                                    </span>

                                    <span class="font-body-md
                                        text-on-surface">

                                        @item.Guests

                                    </span>

                                </div>


                                <!-- STATUS -->

                                <div class="text-right">

                                    <span class="inline-flex
                                        items-center
                                        px-3 py-1
                                        rounded-full
                                        text-[11px]
                                        font-bold
                                        @statusClass
                                        uppercase
                                        tracking-wider">

                                        @item.Status

                                    </span>

                                </div>

                            </div>

                        }

                    }

                </div>

            </div>

        </section>



        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <footer class="mt-auto
            px-container-margin-desktop
            py-6
            border-t border-outline-variant
            bg-surface-container-lowest
            text-on-surface-variant
            flex flex-col
            md:flex-row
            justify-between
            items-center
            gap-4">

            <p class="text-label-sm">

                © 2026 BistroPro Operating System.
                All rights reserved.

            </p>

            <div class="flex gap-6">

                <a href="#"
                   class="text-label-sm
                    hover:text-primary
                    transition-colors">

                    Privacy Policy

                </a>

                <a href="#"
                   class="text-label-sm
                    hover:text-primary
                    transition-colors">

                    Support Center

                </a>

                <a href="#"
                   class="text-label-sm
                    hover:text-primary
                    transition-colors">

                    System Status

                </a>

            </div>

        </footer>

    </main>



    <!-- ===================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================================== -->

    <script>

            // =====================================================
            // CURRENT SELECTED DATE
            // =====================================================

            let selectedDate = '@(
                        Model.Reservations != null && Model.Reservations.Any()
        ? Model.Reservations.First().ReservationDate.ToString("yyyy-MM-dd")
        : DateTime.Today.ToString("yyyy-MM-dd")
                        )';



            // =====================================================
            // ELEMENTS
            // =====================================================

            const previousDayButton =
                document.getElementById("previousDay");

            const nextDayButton =
                document.getElementById("nextDay");

            const selectedDateElement =
                document.getElementById("selectedDate");

            const totalGuestsElement =
                document.getElementById("totalGuests");

            const totalReservationsElement =
                document.getElementById("totalReservations");

            const reservationsBody =
                document.getElementById("reservationsBody");

            const scheduleContainer =
                document.getElementById("scheduleContainer");

            const searchInput =
                document.getElementById("searchInput");



            // =====================================================
            // LOAD SCHEDULE
            // =====================================================

            async function loadSchedule(date) {

                try {

                    scheduleContainer.classList.add("schedule-loading");

                    console.log("Loading schedule for:", date);

                    const response = await fetch(
                        `/Admins/FilterSchedule?date=${encodeURIComponent(date)}`,
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );

                    console.log("Response status:", response.status);

                    if (!response.ok) {

                        const errorText = await response.text();

                        console.error("Raw response:", errorText);

                        throw new Error(
                            `Server returned ${response.status}: ${errorText}`
                        );

                    }

                    const data = await response.json();

                    console.log("Schedule data:", data);


                    // UPDATE SELECTED DATE

                    selectedDate = date;


                    // UPDATE DATE TEXT

                    selectedDateElement.textContent =
                        formatDate(date);


                    // UPDATE STATS

                    totalGuestsElement.textContent =
                        data.totalGuests ?? 0;

                    totalReservationsElement.textContent =
                        data.totalReservations ?? 0;


                    // UPDATE RESERVATIONS

                    renderReservations(
                        data.reservations ?? []
                    );

                }
                catch (error) {

                    console.error(
                        "Schedule loading error:",
                        error
                    );

                    reservationsBody.innerHTML = `

                                <div class="px-6 py-12
                                            text-center
                                            text-red-500">

                                    <span class="material-symbols-outlined
                                                 text-4xl mb-3">

                                        error

                                    </span>

                                    <p class="font-semibold">

                                        Failed to load schedule.

                                    </p>

                                    <p class="text-sm mt-1">

                                        Please try again.

                                    </p>

                                </div>

                            `;

                }
                finally {

                    scheduleContainer.classList.remove(
                        "schedule-loading"
                    );

                }

            }



            // =====================================================
            // RENDER RESERVATIONS
            // =====================================================

            function renderReservations(reservations) {

                if (!reservations ||
                    reservations.length === 0) {

                    reservationsBody.innerHTML = `

                                <div class="px-6 py-12
                                            text-center
                                            text-on-surface-variant">

                                    <span class="material-symbols-outlined
                                                 text-4xl
                                                 mb-3">

                                        event_busy

                                    </span>

                                    <p class="font-semibold">

                                        No reservations for this day.

                                    </p>

                                    <p class="text-sm mt-1">

                                        There are no reservations scheduled for this day.

                                    </p>

                                </div>

                            `;

                    return;

                }


                reservationsBody.innerHTML =
                    reservations.map(reservation => {

                        const status =
                            reservation.status ?? "Unknown";

                        const statusClass =
                            getStatusClass(status);

                        const initials =
                            getInitials(
                                reservation.customerName
                            );

                        const time =
                            formatTime(
                                reservation.reservationDate
                            );

                        const customerName =
                            escapeHtml(
                                reservation.customerName ?? "Unknown"
                            );

                        const tableNumber =
                            escapeHtml(
                                String(
                                    reservation.tableNumber ?? "-"
                                )
                            );

                        const guests =
                            reservation.guests ?? 0;


                        return `

                                    <div class="schedule-row
                                                grid grid-cols-6
                                                px-6 py-5
                                                hover:bg-surface-container-lowest
                                                transition-colors
                                                items-center
                                                group">

                                        <!-- TIME -->

                                        <div class="flex flex-col">

                                            <span class="font-headline-md
                                                         text-[16px]
                                                         text-on-surface">

                                                ${time}

                                            </span>

                                        </div>


                                        <!-- CUSTOMER -->

                                        <div class="col-span-2
                                                    flex items-center gap-3">

                                            <div class="w-8 h-8
                                                        rounded-full
                                                        bg-secondary-container
                                                        flex items-center
                                                        justify-center
                                                        text-primary
                                                        font-bold
                                                        text-xs">

                                                ${initials}

                                            </div>

                                            <span class="font-body-md
                                                         font-semibold
                                                         text-on-surface">

                                                ${customerName}

                                            </span>

                                        </div>


                                        <!-- TABLE -->

                                        <div>

                                            <span class="px-2 py-1
                                                         bg-surface-container
                                                         rounded
                                                         font-label-md
                                                         text-label-md
                                                         text-on-surface">

                                                ${tableNumber}

                                            </span>

                                        </div>


                                        <!-- GUESTS -->

                                        <div class="flex items-center gap-1">

                                            <span class="material-symbols-outlined
                                                         text-[18px]
                                                         text-on-surface-variant">

                                                person

                                            </span>

                                            <span class="font-body-md
                                                         text-on-surface">

                                                ${guests}

                                            </span>

                                        </div>


                                        <!-- STATUS -->

                                        <div class="text-right">

                                            <span class="inline-flex
                                                         items-center
                                                         px-3 py-1
                                                         rounded-full
                                                         text-[11px]
                                                         font-bold
                                                         ${statusClass}
                                                         uppercase
                                                         tracking-wider">

                                                ${escapeHtml(status)}

                                            </span>

                                        </div>

                                    </div>

                                `;

                    }).join("");

            }



            // =====================================================
            // STATUS COLOR
            // =====================================================

            function getStatusClass(status) {

                switch (String(status).toLowerCase()) {

                    case "confirmed":

                        return "bg-emerald-100 text-emerald-800";

                    case "pending":

                        return "bg-yellow-100 text-yellow-800";

                    case "completed":

                        return "bg-blue-100 text-blue-800";

                    case "cancelled":

                        return "bg-red-100 text-red-800";

                    default:

                        return "bg-gray-100 text-gray-800";

                }

            }



            // =====================================================
            // GET INITIALS
            // =====================================================

            function getInitials(name) {

                if (!name ||
                    !name.trim()) {

                    return "NA";

                }

                return name
                    .trim()
                    .split(/\s+/)
                    .slice(0, 2)
                    .map(x => x.charAt(0))
                    .join("")
                    .toUpperCase();

            }



            // =====================================================
            // FORMAT DATE
            // =====================================================

            function formatDate(date) {

                const dateObject =
                    new Date(`${date}T00:00:00`);

                return dateObject.toLocaleDateString(
                    "en-US",
                    {
                        weekday: "long",
                        month: "long",
                        day: "2-digit",
                        year: "numeric"
                    }
                );

            }



            // =====================================================
            // FORMAT TIME
            // =====================================================

            function formatTime(dateString) {

                if (!dateString) {

                    return "--:--";

                }

                const date =
                    new Date(dateString);

                if (isNaN(date.getTime())) {

                    return "--:--";

                }

                return date.toLocaleTimeString(
                    "en-US",
                    {
                        hour: "2-digit",
                        minute: "2-digit",
                        hour12: true
                    }
                );

            }



            // =====================================================
            // ESCAPE HTML
            // =====================================================

            function escapeHtml(value) {

                if (value === null ||
                    value === undefined) {

                    return "";

                }

                return String(value)
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");

            }



            // =====================================================
            // CHANGE DATE
            // =====================================================

            function changeDate(days) {

                const currentDate =
                    new Date(`${selectedDate}T00:00:00`);

                currentDate.setDate(
                    currentDate.getDate() + days
                );

                const year =
                    currentDate.getFullYear();

                const month =
                    String(
                        currentDate.getMonth() + 1
                    ).padStart(2, "0");

                const day =
                    String(
                        currentDate.getDate()
                    ).padStart(2, "0");

                const newDate =
                    `${year}-${month}-${day}`;

                loadSchedule(newDate);

            }



            // =====================================================
            // PREVIOUS DAY
            // =====================================================

            previousDayButton.addEventListener(
                "click",
                function() {

                    changeDate(-1);

                }
            );



            // =====================================================
            // NEXT DAY
            // =====================================================

            nextDayButton.addEventListener(
                "click",
                function() {

                    changeDate(1);

                }
            );



            // =====================================================
            // SEARCH
            // =====================================================

            searchInput.addEventListener(
                "input",
                function() {

                    const searchValue =
                        this.value
                            .trim()
                            .toLowerCase();

                    const rows =
                        document.querySelectorAll(
                            ".schedule-row"
                        );

                    rows.forEach(row => {

                        const text =
                            row.textContent
                                .toLowerCase();

                        row.style.display =
                            text.includes(searchValue)
                                ? ""
                                : "none";

                    });

                }
            );



            // =====================================================
            // SEARCH INPUT EFFECT
            // =====================================================

            searchInput.addEventListener(
                "focus",
                () => {

                    searchInput.parentElement.classList.add(
                        "ring-2",
                        "ring-primary/20"
                    );

                }
            );


            searchInput.addEventListener(
                "blur",
                () => {

                    searchInput.parentElement.classList.remove(
                        "ring-2",
                        "ring-primary/20"
                    );

                }
            );



            // =====================================================
            // INITIALIZE
            // =====================================================

            console.log(
                "Schedule initialized with date:",
                selectedDate
            );

    </script>

</body>

</html>