@using Restaurant_Management.ViewModels.Admins
@{
    Layout = null;
    @model ReservationViewModel
}

<!DOCTYPE html>

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Reservations | BistroPro</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-secondary-fixed-variant": "#38485d",
                        "on-error": "#ffffff",
                        "surface-bright": "#fcf8ff",
                        "error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "on-tertiary": "#ffffff",
                        "background": "#fcf8ff",
                        "surface-tint": "#4d44e3",
                        "on-secondary": "#ffffff",
                        "outline-variant": "#c7c4d8",
                        "on-primary-fixed": "#0f0069",
                        "tertiary-fixed-dim": "#ffb695",
                        "tertiary-fixed": "#ffdbcc",
                        "surface-container-low": "#f5f2ff",
                        "secondary-fixed-dim": "#b7c8e1",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-error-container": "#93000a",
                        "tertiary": "#7e3000",
                        "surface-dim": "#dcd8e5",
                        "outline": "#777587",
                        "primary-fixed-dim": "#c3c0ff",
                        "on-tertiary-container": "#ffd2be",
                        "surface-container-high": "#eae6f4",
                        "on-primary": "#ffffff",
                        "on-secondary-container": "#54647a",
                        "surface-container-highest": "#e4e1ee",
                        "on-surface": "#1b1b24",
                        "tertiary-container": "#a44100",
                        "on-primary-container": "#dad7ff",
                        "surface": "#fcf8ff",
                        "on-background": "#1b1b24",
                        "surface-container-lowest": "#ffffff",
                        "inverse-surface": "#302f39",
                        "on-secondary-fixed": "#0b1c30",
                        "primary": "#3525cd",
                        "surface-container": "#f0ecf9",
                        "on-surface-variant": "#464555",
                        "secondary-container": "#d0e1fb",
                        "error": "#ba1a1a",
                        "secondary": "#505f76",
                        "inverse-on-surface": "#f3effc",
                        "on-tertiary-fixed": "#351000",
                        "primary-fixed": "#e2dfff",
                        "inverse-primary": "#c3c0ff",
                        "surface-variant": "#e4e1ee"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "8px",
                        "container-margin-desktop": "32px",
                        "sidebar-width": "280px",
                        "container-margin-mobile": "16px",
                        "gutter": "24px"
                    },
                    "fontFamily": {
                        "display-lg": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-lg": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "body-md": ["Inter"],
                        "headline-md": ["Inter"]
                    },
                    "fontSize": {
                        "display-lg": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "headline-lg": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}],
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}]
                    }
                },
            },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-background text-on-surface">
    <!-- SideNavBar (Authority Source: JSON) -->
    <aside class="fixed left-0 top-0 h-screen w-sidebar-width bg-surface-container-low border-r border-outline-variant flex flex-col py-base gap-2 z-50">
        <div class="px-6 py-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center text-on-primary">
                <span class="material-symbols-outlined" data-icon="restaurant_menu">restaurant_menu</span>
            </div>
            <div>
                <h1 class="font-display-lg text-display-lg font-black text-primary leading-tight">BistroPro</h1>
                <p class="font-label-md text-label-md text-on-surface-variant opacity-70">Downtown Branch</p>
            </div>
        </div>
        <nav class="flex-1 mt-4 px-3 flex flex-col gap-1">
            <!-- Navigation Items with Active State Logic for "Reservations" -->
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200" href="index">
                <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                <span class="font-label-md text-label-md">Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary-container text-on-secondary-container border-l-4 border-primary font-bold shadow-sm" href="reservations">
                <span class="material-symbols-outlined" data-icon="book_online">book_online</span>
                <span class="font-label-md text-label-md">Reservations</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200" href="tables">
                <span class="material-symbols-outlined" data-icon="table_restaurant">table_restaurant</span>
                <span class="font-label-md text-label-md">Tables</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200" href="schedule">
                <span class="material-symbols-outlined" data-icon="calendar_month">calendar_month</span>
                <span class="font-label-md text-label-md">Schedule</span>
            </a>
        </nav>
        <div class="px-3 mt-auto">
            <button class="w-full py-4 bg-primary text-on-primary font-bold rounded-xl flex items-center justify-center gap-2 hover:opacity-90 active:scale-95 transition-all">
                <span class="material-symbols-outlined" data-icon="add">add</span>
                <span class="font-label-md text-label-md">New Reservation</span>
            </button>
        </div>
    </aside>
    <!-- TopNavBar (Authority Source: JSON) -->
    <header class="fixed top-0 right-0 left-sidebar-width h-16 px-container-margin-desktop bg-surface border-b border-outline-variant flex justify-between items-center z-40">
        <div class="flex items-center gap-4 flex-1">
            <div class="relative w-full max-w-md">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" data-icon="search">search</span>
                <input class="w-full bg-surface-container-low border border-outline-variant rounded-full pl-10 pr-4 py-2 text-body-md focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" placeholder="Search reservations..." type="text" />
            </div>
        </div>
        <div class="flex items-center gap-4">
            <button class="p-2 text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors">
                <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
            </button>
            <button class="p-2 text-on-surface-variant hover:bg-surface-container-high rounded-full transition-colors">
                <span class="material-symbols-outlined" data-icon="settings">settings</span>
            </button>
            <div class="h-8 w-[1px] bg-outline-variant mx-2"></div>
            <div class="flex items-center gap-3">
                <div class="text-right hidden sm:block">
                    <p class="font-label-md text-label-md font-bold text-on-surface">Alex Rivera</p>
                    <p class="text-[10px] text-on-surface-variant uppercase tracking-wider">Manager</p>
                </div>
                <img alt="Manager Profile" class="w-10 h-10 rounded-full border-2 border-primary-container object-cover" data-alt="A professional headshot of a restaurant manager in a sharp grey suit against a blurred office background. The lighting is soft and corporate, conveying trust and efficiency. The manager has a warm but authoritative expression, fitting for a premium SaaS application interface." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAWmnDsio4nCm5Iuzuzs-xafYi8mpNXHYyi4ESL0YpeD_7i8tD4yTXkin_DytQzwmWykEFHSOs3tm_EAZznfQgmWgPSr8K_OEDL19-EoWNrEAeuIE3jnDlbbw5d38ZmM3yDuoh6MZ3s0bxKpCN_36Myx7ahKk7oxhmBGRrSV8Y6hDgGb5G9QPjAwvEj-fFgP3f2yCLvleFxv6W5n1FOsU1AaqeOHqj7-ujFCJqYFZ19MvCOPYnSP61UlZkiJhdRS39ourdRntgXOBw" />
            </div>
        </div>
    </header>
    <!-- Main Content Canvas -->
    <main class="ml-sidebar-width pt-16 min-h-screen">
        <div class="p-container-margin-desktop max-w-[1440px] mx-auto">
            <!-- Page Header Section -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
                <div>
                    <h2 class="font-display-lg text-display-lg text-on-surface">Reservations</h2>
                    <p class="font-body-md text-body-md text-on-surface-variant">Manage your restaurant's bookings and table assignments.</p>
                </div>
                <div class="flex gap-3">
                    <button class="px-5 py-2.5 border border-outline rounded-lg flex items-center gap-2 font-label-md text-label-md text-secondary hover:bg-surface-container-low transition-colors">
                        <span class="material-symbols-outlined" data-icon="file_download">file_download</span>
                        Export
                    </button>
                    <button class="px-5 py-2.5 bg-primary text-on-primary rounded-lg flex items-center gap-2 font-label-md text-label-md font-bold shadow-lg hover:shadow-primary/20 transition-all active:scale-95">
                        <span class="material-symbols-outlined" data-icon="add">add</span>
                        + New Reservation
                    </button>
                </div>
            </div>
            <!-- Dashboard Stats / Filters Bento Grid Row -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-8">
                <!-- Status Filter Card -->
                <div class="bg-surface-container-lowest border border-outline-variant p-5 rounded-xl shadow-sm col-span-1">
                    <label class="font-label-md text-label-md text-on-surface-variant mb-2 block">Filter by Status</label>
                    <select class="w-full bg-surface border border-outline-variant rounded-lg p-2.5 font-body-md text-on-surface focus:ring-2 focus:ring-primary/20 outline-none">
                        <option>All Statuses</option>
                        <option>Confirmed</option>
                        <option>Pending</option>
                        <option>Cancelled</option>
                    </select>
                </div>
                <!-- Date Filter Card -->
                <div class="bg-surface-container-lowest border border-outline-variant p-5 rounded-xl shadow-sm col-span-1">
                    <label class="font-label-md text-label-md text-on-surface-variant mb-2 block">Date Select</label>
                    <div class="relative">
                        <input class="w-full bg-surface border border-outline-variant rounded-lg p-2.5 font-body-md text-on-surface focus:ring-2 focus:ring-primary/20 outline-none" type="date" value="2023-11-24" />
                    </div>
                </div>
                <!-- Mini Metric Card -->
                <div class="bg-primary text-on-primary p-5 rounded-xl shadow-md col-span-1 relative overflow-hidden">
                    <div class="relative z-10">
                        <p class="font-label-md text-label-md opacity-80 mb-1">Today's Total</p>
                        <p class="text-3xl font-bold tracking-tight">@Model.TodayReservations</p>
                    </div>
                    <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-7xl opacity-10" data-icon="trending_up">trending_up</span>
                </div>
                <!-- Mini Metric Card -->
                <div class="bg-secondary-container text-on-secondary-container p-5 rounded-xl border border-outline-variant col-span-1 relative overflow-hidden">
                    <div class="relative z-10">
                        <p class="font-label-md text-label-md text-on-secondary-container opacity-80 mb-1">Pending Requests</p>
                        <p class="text-3xl font-bold text-on-secondary-container tracking-tight">@Model.PendingRequests</p>
                    </div>
                    <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-7xl opacity-10" data-icon="hourglass_empty">hourglass_empty</span>
                </div>
            </div>

            <!-- الحاوية الجديدة التي تضع الجدول والـ Quick Actions بجانب بعضهما -->
            <div class="flex flex-col xl:flex-row gap-gutter items-start">
                <!-- Reservations Data Table -->
                <div class="flex-1 w-full bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden">
                    <div class="p-6 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
                        <h3 class="font-headline-md text-headline-md text-on-surface">Live Reservations</h3>
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                            <span class="text-xs font-label-md text-on-surface-variant">Live Updates Enabled</span>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low border-b border-outline-variant">
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Customer Name</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Phone</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Guests</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Date &amp; Time</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Table</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant">Status</th>
                                    <th class="px-6 py-4 font-label-md text-label-md text-on-surface-variant text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-outline-variant">
                                @foreach (var item in Model.ReservationsOfToday)
                                {
                                    <tr class="hover:bg-surface-container-low transition-colors group h-14">
                                        <td class="px-6 py-4 font-body-md text-on-surface font-semibold">@item.CustomerName</td>
                                        <td class="px-6 py-4 font-body-md text-on-surface-variant">@item.PhoneNNumber</td>
                                        <td class="px-6 py-4 font-body-md">
                                            <span class="flex items-center gap-1.5">
                                                <span class="material-symbols-outlined text-sm opacity-60" data-icon="person">person</span>
                                                @item.Guests
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 font-body-md">@item.ReservationTime</td>
                                        <td class="px-6 py-4 font-body-md">
                                            <span class="bg-surface-container-high px-2 py-1 rounded text-xs font-bold">@item.TableNumber</span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                                <button class="p-1.5 text-secondary hover:bg-secondary-container rounded-lg"><span class="material-symbols-outlined text-xl" data-icon="edit">edit</span></button>
                                                <button class="p-1.5 text-error hover:bg-error-container rounded-lg"><span class="material-symbols-outlined text-xl" data-icon="delete">delete</span></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* Quick Actions *@
                <div class="w-full xl:w-80 shrink-0 bg-surface-container-lowest border border-outline-variant rounded-xl p-6 shadow-sm">
                    <h3 class="font-headline-md text-headline-md mb-6">Quick Actions</h3>
                    <div class="space-y-3">
                        <button class="w-full flex items-center justify-between p-4 bg-surface-container-low hover:bg-primary-container/10 border border-transparent hover:border-primary/20 rounded-lg transition-all text-left">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-primary" data-icon="auto_awesome">auto_awesome</span>
                                <span class="font-label-md text-label-md">Auto-Assign Tables</span>
                            </div>
                            <span class="material-symbols-outlined text-on-surface-variant text-sm" data-icon="chevron_right">chevron_right</span>
                        </button>
                        <button class="w-full flex items-center justify-between p-4 bg-surface-container-low hover:bg-primary-container/10 border border-transparent hover:border-primary/20 rounded-lg transition-all text-left">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-primary" data-icon="print">print</span>
                                <span class="font-label-md text-label-md">Print Daily Brief</span>
                            </div>
                            <span class="material-symbols-outlined text-on-surface-variant text-sm" data-icon="chevron_right">chevron_right</span>
                        </button>
                        <button class="w-full flex items-center justify-between p-4 bg-surface-container-low hover:bg-primary-container/10 border border-transparent hover:border-primary/20 rounded-lg transition-all text-left">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-primary" data-icon="group_add">group_add</span>
                                <span class="font-label-md text-label-md">Manage Waitlist</span>
                            </div>
                            <span class="material-symbols-outlined text-on-surface-variant text-sm" data-icon="chevron_right">chevron_right</span>
                        </button>
                        <button class="w-full flex items-center justify-between p-4 bg-surface-container-low hover:bg-primary-container/10 border border-transparent hover:border-primary/20 rounded-lg transition-all text-left">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-primary" data-icon="mail">mail</span>
                                <span class="font-label-md text-label-md">Send SMS Alerts</span>
                            </div>
                            <span class="material-symbols-outlined text-on-surface-variant text-sm" data-icon="chevron_right">chevron_right</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>
    <script>
        // Micro-interactions and effects
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => {
                el.classList.add('scale-95');
            });
            el.addEventListener('mouseup', () => {
                el.classList.remove('scale-95');
            });
        });

        // Search bar highlight effect
        const searchInput = document.querySelector('input[type="text"]');
        searchInput.addEventListener('focus', () => {
            searchInput.parentElement.classList.add('scale-[1.02]');
        });
        searchInput.addEventListener('blur', () => {
            searchInput.parentElement.classList.remove('scale-[1.02]');
        });
    </script>
</body>
</html>