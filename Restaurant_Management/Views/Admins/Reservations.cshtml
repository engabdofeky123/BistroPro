                </div>



                <!-- TODAY -->

                <div class="bg-primary
                    text-white
                    p-5
                    rounded-xl
                    shadow-md">

                    <p class="text-xs opacity-80 mb-1">

                        Today's Total

                    </p>


                    <p id="todayReservationsCount"
                       class="text-3xl font-bold">

                        @Model.TodayReservations

                    </p>

                </div>



                <!-- PENDING -->

                <div class="bg-secondary-container
                    text-on-secondary-container
                    p-5
                    rounded-xl
                    border border-outline-variant">

                    <p class="text-xs opacity-80 mb-1">

                        Pending Requests

