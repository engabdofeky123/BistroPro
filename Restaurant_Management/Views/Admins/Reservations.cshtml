                                            @item.PhoneNNumber

                                        </td>


                                        <td class="px-4 py-3">

                                            <span class="flex items-center gap-1.5">

                                                <span class="material-symbols-outlined text-sm">

                                                    person

                                                </span>

                                                @item.Guests

                                            </span>

                                        </td>


                                        <td class="px-4 py-3 whitespace-nowrap">

                                            @item.ReservationTime.ToString("dd MMM yyyy")

                                        </td>


                                        <td class="px-4 py-3 whitespace-nowrap">

                                            <span class="bg-surface-container-high
                                                px-2 py-1
