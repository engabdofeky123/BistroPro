                    p-4
                    shadow-sm">


                    <h3 class="text-xl font-semibold mb-4">

                        Quick Actions

                    </h3>


                    <div class="space-y-3">


                        <a href="/Slots/index"
                           class="w-full
                            flex items-center
                            justify-between
                            p-3
                            bg-surface-container-low
                            hover:bg-primary/10
                            rounded-lg
                            transition">


                            <div class="flex items-center gap-2">

                                <span class="material-symbols-outlined text-primary">

                                    schedule

                                </span>


                                <span class="text-xs font-semibold">

                                    Reservation Slots

                                </span>

                            </div>


                            <span class="material-symbols-outlined text-sm">

                                chevron_right

                            </span>

                        </a>



                        <a asp-action="PrintDailyBrief"
                           asp-controller="Admins"
                           asp-route-date="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full
                            flex items-center
                            justify-between
                            p-3
                            bg-surface-container-low
                            hover:bg-primary/10
                            rounded-lg
                            transition">


                            <div class="flex items-center gap-2">

                                <span class="material-symbols-outlined text-primary">

                                    print

                                </span>


                                <span class="text-xs font-semibold">

                                    Print Daily Brief

                                </span>

                            </div>


                            <span class="material-symbols-outlined text-sm">

                                chevron_right

                            </span>

                        </a>


                    </div>

                </div>

            </div>

        </div>

    </main>



    <!-- ===================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================================== -->

    <script>

            // =====================================================
            // DELETE RESERVATION
            // =====================================================

            function deleteReservation(id) {

                const confirmed = confirm(
                    "Are you sure you want to delete this reservation?"
                );

                if (!confirmed)
                    return;


                $.ajax({

                    url: `/Reservations/delete/${id}`,

                    type: "DELETE",

                    success: function(response) {

                        alert(response.message);

                        location.reload();

                    },

                    error: function(xhr) {

                        console.error(xhr.responseText);

                        alert(
                            xhr.responseJSON?.message ||
                            "Failed to delete reservation."
                        );

                    }

                });

            }



            // =====================================================
            // CHANGE RESERVATION STATUS
            // =====================================================

            $(document).on("change", ".reservation-status", function() {

                const select = $(this);

                const reservationId = select.data("id");

                const newStatus = select.val();

                const oldStatus = select.data("current");


                if (!reservationId || !newStatus)
                    return;


                $.ajax({

                    url: "/Reservations/change-status",

                    type: "PUT",

                    data: {

                        reservationId: reservationId,

                        status: newStatus

                    },


                    success: function(response) {

                        console.log(response);

                        select.data("current", newStatus);

                        updateStatusColor(select, newStatus);

                        showSuccessMessage(
                            response.message ||
                            "Reservation status updated successfully."
                        );

                    },


                    error: function(xhr) {

                        console.error(
                            "Status Change Error:",
                            xhr.responseText
                        );

                        select.val(oldStatus);

                        updateStatusColor(select, oldStatus);

                        alert(
                            xhr.responseJSON?.message ||
                            "Failed to update reservation status."
                        );

                    }

                });

            });



            // =====================================================
            // STATUS COLOR
            // =====================================================

            function updateStatusColor(select, status) {

                select.removeClass(

                    "bg-green-100",
                    "text-green-800",

                    "bg-yellow-100",
                    "text-yellow-800",

                    "bg-blue-100",
                    "text-blue-800",

                    "bg-red-100",
                    "text-red-800"

                );


                switch (status) {

                    case "Confirmed":

                        select.addClass(
                            "bg-green-100",
                            "text-green-800"
                        );

                        break;


                    case "Pending":

                        select.addClass(
                            "bg-yellow-100",
                            "text-yellow-800"
                        );

                        break;


                    case "Completed":

                        select.addClass(
                            "bg-blue-100",
                            "text-blue-800"
                        );

                        break;


                    case "Cancelled":

                        select.addClass(
                            "bg-red-100",
                            "text-red-800"
                        );

                        break;

                }

            }



            // =====================================================
            // SUCCESS MESSAGE
            // =====================================================

            function showSuccessMessage(message) {

                const success = $(`
                            <div
                                class="fixed top-5 left-1/2
                                       -translate-x-1/2
                                       z-[9999]
                                       bg-green-600
                                       text-white
                                       px-6 py-3
                                       rounded-lg
                                       shadow-lg
                                       font-semibold">

                                ${message}

                            </div>
                        `);


                $("body").append(success);


                setTimeout(function() {

                    success.fadeOut(300, function() {

                        $(this).remove();

                    });

                }, 2500);

            }



            // =====================================================
            // FILTER RESERVATIONS
            // =====================================================

            $("#statusFilter").on(
                "change",
                filterReservations
            );

            $("#dateFilter").on(
                "change",
                filterReservations
            );


            function filterReservations() {

                const status = $("#statusFilter").val();

                const date = $("#dateFilter").val();


                $.ajax({

                    url: "/Reservations/FilterReservations",

                    type: "GET",

                    data: {

                        status: status,

                        date: date

                    },

                    dataType: "json",


                    success: function(reservations) {

                        renderReservations(reservations);

                    },


                    error: function(xhr) {

                        console.error(xhr);

                        $("#reservationsTableBody").html(`

                                    <tr>

                                        <td colspan="8"
                                            class="px-6 py-8
                                                   text-center
                                                   text-error">

                                            Failed to load reservations.

                                        </td>

                                    </tr>

                                `);

                    }

                });

            }



            // =====================================================
            // RENDER RESERVATIONS
            // =====================================================

            function renderReservations(reservations) {

                const tbody =
                    $("#reservationsTableBody");


                tbody.empty();


                if (!reservations ||
                    reservations.length === 0) {

                    tbody.html(`

                                <tr>

                                    <td colspan="8"
                                        class="px-6 py-8
                                               text-center
                                               text-on-surface-variant">

                                        No reservations found.

                                    </td>

                                </tr>

                            `);

                    return;

                }


                reservations.forEach(function(item) {

                    const status = item.status;


                    const row = `

                                <tr class="
                                    hover:bg-surface-container-low
                                    transition-colors
                                    group
                                    h-14
                                ">


                                    <td class="px-4 py-3 font-semibold">

                                        ${item.customerName ?? "No Name"}

                                    </td>


                                    <td class="
                                        px-4 py-3
                                        text-on-surface-variant
                                    ">

                                        ${item.phoneNNumber ?? "No Phone"}

                                    </td>


                                    <td class="px-4 py-3">

                                        <span class="
                                            flex
                                            items-center
                                            gap-1.5
                                        ">

                                            <span class="
                                                material-symbols-outlined
                                                text-sm
                                            ">

                                                person

                                            </span>

                                            ${item.guests ?? 0}

                                        </span>

                                    </td>


                                    <td class="
                                        px-4 py-3
                                        whitespace-nowrap
                                    ">

                                        ${formatDate(
                        item.reservationTime
                    )}

                                    </td>


                                    <td class="
                                        px-4 py-3
                                        whitespace-nowrap
                                    ">

                                        <span class="
                                            bg-surface-container-high
                                            px-2 py-1
                                            rounded-lg
                                            text-xs
                                            font-bold
                                        ">

                                            ${formatTime(item.startTime)}

                                            -

                                            ${formatTime(item.endTime)}

                                        </span>

                                    </td>


                                    <td class="px-4 py-3">

                                        <span class="
                                            bg-surface-container-high
                                            px-2 py-1
                                            rounded
                                            text-xs
                                            font-bold
                                        ">

                                            ${item.tableNumber ?? "N/A"}

                                        </span>

                                    </td>


                                    <td class="px-4 py-3">

                                        <select
                                            class="
                                                status-select
                                                reservation-status
                                                border
                                                rounded-lg
                                                px-2
                                                py-1.5
                                                text-xs
                                                font-bold
                                            "

                                            data-id="${item.reservationId}"

                                            data-current="${status}"

                                        >

                                            <option value="Pending"
                                                ${status === "Pending"
                            ? "selected"
                            : ""}>

                                                Pending

                                            </option>


                                            <option value="Confirmed"
                                                ${status === "Confirmed"
                            ? "selected"
                            : ""}>

                                                Confirmed

                                            </option>


                                            <option value="Completed"
                                                ${status === "Completed"
                            ? "selected"
                            : ""}>

                                                Completed

                                            </option>


                                            <option value="Cancelled"
                                                ${status === "Cancelled"
                            ? "selected"
                            : ""}>

                                                Cancelled

                                            </option>

                                        </select>

                                    </td>


                                    <td class="px-4 py-3 text-right">

                                        <div class="
                                            flex
                                            justify-end
                                            gap-2
                                        ">


                                            <a
                                                href="/Reservations/update/${item.reservationId}"

                                                class="
                                                    p-1.5
                                                    text-secondary
                                                    hover:bg-secondary-container
                                                    rounded-lg
                                                ">

                                                <span class="
                                                    material-symbols-outlined
                                                    text-xl
                                                ">

                                                    edit

                                                </span>

                                            </a>


                                            <button
                                                type="button"

                                                onclick="
                                                    deleteReservation(
                                                        ${item.reservationId}
                                                    )
                                                "

                                                class="
                                                    p-1.5
                                                    text-error
                                                    hover:bg-error-container
                                                    rounded-lg
                                                ">

                                                <span class="
                                                    material-symbols-outlined
                                                    text-xl
                                                ">

                                                    delete

                                                </span>

                                            </button>


                                        </div>

                                    </td>

                                </tr>

                            `;


                    tbody.append(row);


                    const select =
                        tbody.find(
                            `select[data-id="${item.reservationId}"]`
                        );


                    updateStatusColor(
                        select,
                        status
                    );

                });

            }



            // =====================================================
            // FORMAT DATE
            // =====================================================

            function formatDate(dateString) {

                if (!dateString)
                    return "";


                const date =
                    new Date(dateString);


                return date.toLocaleDateString(
                    "en-GB",
                    {

                        day: "2-digit",

                        month: "short",

                        year: "numeric"

                    }
                );

            }



            // =====================================================
            // FORMAT TIME
            // =====================================================

            function formatTime(timeString) {

                if (!timeString)
                    return "";


                const parts =
                    timeString.split(":");


                let hours =
                    parseInt(parts[0]);


                const minutes =
                    parts[1];


                const period =
                    hours >= 12
                        ? "PM"
                        : "AM";


                hours =
                    hours % 12;


                if (hours === 0)
                    hours = 12;


                return `${hours}:${minutes} ${period}`;

            }



            // =====================================================
            // INITIAL STATUS COLORS
            // =====================================================

            $(document).ready(function() {

                $(".reservation-status").each(function() {

                    const select = $(this);

                    updateStatusColor(
                        select,
                        select.val()
                    );

                });

            });

    </script>


</body>

</html>