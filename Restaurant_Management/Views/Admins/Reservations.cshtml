                                                rounded-lg
                                                px-2 py-1.5
                                                text-xs
                                                font-bold"
                                                    data-id="@item.ReservationId"
                                                    data-current="@item.Status">

                                                <option value="Pending"
                                                        selected="@(item.Status.ToString() == "Pending")">

                                                    Pending

                                                </option>

                                                <option value="Confirmed"
                                                        selected="@(item.Status.ToString() == "Confirmed")">

                                                    Confirmed

                                                </option>

                                                <option value="Completed"
                                                        selected="@(item.Status.ToString() == "Completed")">

                                                    Completed

                                                </option>

                                                <option value="Cancelled"
                                                        selected="@(item.Status.ToString() == "Cancelled")">

