@using Application.DTOs.Admins
@model ScheduleDto

@{
    Layout = null;

    var reservations = @Model?.Reservations?
        .OrderBy(x => x.ReservationDate)
        .ToList();


    var selectedDate = reservations.FirstOrDefault()?.ReservationDate.Date
                       ?? DateTime.Today;

    var totalReservations = reservations.Count;

    var totalGuests = reservations.Sum(x => x.Guests);

    var confirmedCount = reservations.Count(x =>
        x.Status.ToString() == "Confirmed");

    var pendingCount = reservations.Count(x =>
        x.Status.ToString() == "Pending");

    var completedCount = reservations.Count(x =>
        x.Status.ToString() == "Completed");

    var cancelledCount = reservations.Count(x =>
        x.Status.ToString() == "Cancelled");
}

<!DOCTYPE html>

<html class="light" lang="en">

<head>

    <meta charset="utf-8" />

    <meta content="width=device-width, initial-scale=1.0"
          name="viewport" />

    <title>
        Print Daily Brief - BistroPro
    </title>


    <!-- Tailwind -->

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries">
    </script>


    <!-- Google Fonts -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />


    <!-- Material Icons -->

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />


    <style>

            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: #fcf8ff;
            }

            .document-shadow {
                box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            }

            .grain-texture {
                background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png");
                opacity: 0.03;
                pointer-events: none;
            }

            @@media print {

                body {
                    background: white !important;
                }

                header,
                .action-section,
                .bottom-action {
                    display: none !important;
                }

                main {
                    padding-top: 20px !important;
                    padding-bottom: 20px !important;
                    max-width: 100% !important;
                }

                .document-preview {
                    box-shadow: none !important;
                    border: none !important;
                    margin: 0 !important;
                    min-height: auto !important;
                }

                .grain-texture {
                    display: none;
                }
            }

    </style>


    <script>

            tailwind.config = {

                darkMode: "class",

                theme: {

                    extend: {

                        colors: {

                            background: "#fcf8ff",
                            surface: "#fcf8ff",
                            primary: "#3525cd",
                            primary- container: "#4f46e5",

                        on- primary: "#ffffff",

                    on- surface: "#1b1b24",

                on- surface - variant: "#464555",

                    outline - variant: "#c7c4d8",

                        secondary - container: "#d0e1fb",

                            on - secondary - container: "#54647a",

                                surface - container: "#f0ecf9",

                                    surface - container - low: "#f5f2ff",

                                        surface - container - high: "#eae6f4",

                                            surface - container - lowest: "#ffffff"

                                },

            borderRadius: {

                DEFAULT: "0.25rem",
                    lg: "0.5rem",
                        xl: "0.75rem",
                            full: "9999px"

            }

                            }

                        }

                    }

    </script>

</head>


<body class="bg-background text-on-surface">


    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <header class="fixed top-0 left-0 right-0
        h-16
        bg-surface
        flex items-center
        px-4
        z-50
        border-b border-outline-variant">


        <button type="button"
                class="p-2 mr-2 rounded-full
            hover:bg-surface-container-high
            transition-colors"
                onclick="window.history.back()">

            <span class="material-symbols-outlined text-on-surface">

                arrow_back

            </span>

        </button>


        <h1 class="text-[20px]
            font-bold
            text-on-surface">

            Print Daily Brief

        </h1>


        <div class="flex-grow"></div>


        <button type="button"
                onclick="window.print()"
                class="p-2 rounded-full
            hover:bg-surface-container-high
            transition-colors">

            <span class="material-symbols-outlined">

                print

            </span>

        </button>

    </header>



    <!-- ========================================================= -->
    <!-- MAIN -->
    <!-- ========================================================= -->

    <main class="pt-20 pb-32 px-4
        max-w-md
        mx-auto">


        <!-- ===================================================== -->
        <!-- DOCUMENT -->
        <!-- ===================================================== -->

        <section class="document-preview
            relative
            bg-white
            rounded-lg
            document-shadow
            overflow-hidden
            min-h-[600px]
            flex flex-col
            p-6
            border border-outline-variant
            mb-8">


            <!-- Texture -->

            <div class="absolute inset-0 grain-texture"></div>



            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="relative
                border-b-2
                border-on-surface
                pb-4
                mb-6">


                <div class="flex
                    justify-between
                    items-end">


                    <!-- TITLE -->

                    <div>

                        <p class="text-[12px]
                            font-semibold
                            text-primary
                            uppercase
                            tracking-widest
                            mb-1">

                            BistroPro Daily

                        </p>


                        <h2 class="text-[20px]
                            font-black
                            text-on-surface">

                            MANAGER BRIEF

                        </h2>

                    </div>


                    <!-- DATE -->

                    <div class="text-right">

                        <p class="text-[12px]
                            font-semibold
                            text-on-surface-variant">

                            @selectedDate.ToString("dddd, MMMM dd, yyyy")

                        </p>


                        <p class="text-[11px]
                            text-on-surface-variant
                            mt-1">

                            Daily Operations Report

                        </p>

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- SUMMARY -->
            <!-- ================================================= -->

            <div class="relative
                grid grid-cols-2
                gap-4
                mb-8">


                <!-- TOTAL RESERVATIONS -->

                <div>

                    <span class="text-[11px]
                        font-semibold
                        text-on-surface-variant
                        uppercase">

                        Reservations

                    </span>


                    <div class="text-[30px]
                        font-bold
                        text-on-surface
                        leading-none
                        mt-1">

                        @totalReservations

                    </div>

                </div>


                <!-- TOTAL GUESTS -->

                <div class="border-l
                    border-outline-variant
                    pl-4">

                    <span class="text-[11px]
                        font-semibold
                        text-on-surface-variant
                        uppercase">

                        Total Covers

                    </span>


                    <div class="text-[30px]
                        font-bold
                        text-primary
                        leading-none
                        mt-1">

                        @totalGuests

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- STATUS SUMMARY -->
            <!-- ================================================= -->

            <div class="relative
                mb-8">


                <h3 class="text-[12px]
                    font-bold
                    text-on-surface
                    border-b
                    border-outline-variant
                    pb-1
                    mb-3
                    uppercase
                    flex
                    items-center">


                    <span class="material-symbols-outlined
                        text-[16px]
                        mr-2">

                        analytics

                    </span>


                    Reservation Status

                </h3>



                <div class="grid grid-cols-2 gap-3">


                    <!-- CONFIRMED -->

                    <div class="p-3
                        rounded-lg
                        bg-emerald-50
                        border border-emerald-100">

                        <p class="text-[10px]
                            uppercase
                            font-bold
                            text-emerald-700">

                            Confirmed

                        </p>


                        <p class="text-xl
                            font-bold
                            text-emerald-800">

                            @confirmedCount

                        </p>

                    </div>



                    <!-- PENDING -->

                    <div class="p-3
                        rounded-lg
                        bg-yellow-50
                        border border-yellow-100">

                        <p class="text-[10px]
                            uppercase
                            font-bold
                            text-yellow-700">

                            Pending

                        </p>


                        <p class="text-xl
                            font-bold
                            text-yellow-800">

                            @pendingCount

                        </p>

                    </div>



                    <!-- COMPLETED -->

                    <div class="p-3
                        rounded-lg
                        bg-blue-50
                        border border-blue-100">

                        <p class="text-[10px]
                            uppercase
                            font-bold
                            text-blue-700">

                            Completed

                        </p>


                        <p class="text-xl
                            font-bold
                            text-blue-800">

                            @completedCount

                        </p>

                    </div>



                    <!-- CANCELLED -->

                    <div class="p-3
                        rounded-lg
                        bg-red-50
                        border border-red-100">

                        <p class="text-[10px]
                            uppercase
                            font-bold
                            text-red-700">

                            Cancelled

                        </p>


                        <p class="text-xl
                            font-bold
                            text-red-800">

                            @cancelledCount

                        </p>

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- RESERVATION LIST -->
            <!-- ================================================= -->

            <div class="relative">


                <h3 class="text-[12px]
                    font-bold
                    text-on-surface
                    border-b
                    border-outline-variant
                    pb-1
                    mb-3
                    uppercase
                    flex
                    items-center">


                    <span class="material-symbols-outlined
                        text-[16px]
                        mr-2">

                        event

                    </span>


                    Today's Reservations

                </h3>



                @if (!reservations.Any())
                {

                    <!-- EMPTY -->

                    <div class="py-8
                        text-center
                        text-on-surface-variant">


                        <span class="material-symbols-outlined
                            text-4xl
                            mb-2">

                            event_busy

                        </span>


                        <p class="font-semibold">

                            No reservations

                        </p>


                        <p class="text-xs mt-1">

                            There are no reservations scheduled for this day.

                        </p>

                    </div>

                }
                else
                {

                    <div class="space-y-3">


                        @foreach (var reservation in reservations)
                        {

                            var status = reservation.Status.ToString();


                            var statusClass = status switch
                            {

                                "Confirmed" =>
                                    "bg-emerald-100 text-emerald-800",

                                "Pending" =>
                                    "bg-yellow-100 text-yellow-800",

                                "Completed" =>
                                    "bg-blue-100 text-blue-800",

                                "Cancelled" =>
                                    "bg-red-100 text-red-800",

                                _ =>
                                    "bg-gray-100 text-gray-800"

                            };


                            <div class="flex
                                justify-between
                                items-center
                                gap-3
                                py-2
                                border-b
                                border-outline-variant
                                last:border-0">


                                <!-- LEFT -->

                                <div class="min-w-0">


                                    <p class="text-[13px]
                                        font-bold
                                        text-on-surface">

                                        @reservation.CustomerName

                                    </p>


                                    <p class="text-[10px]
                                        text-on-surface-variant
                                        mt-1">

                                        @reservation.ReservationDate.ToString("hh:mm tt")

                                        <span class="mx-1">
                                            •
                                        </span>

                                        Table @reservation.TableNumber

                                        <span class="mx-1">
                                            •
                                        </span>

                                        @reservation.Guests Guests

                                    </p>

                                </div>



                                <!-- STATUS -->

                                <span class="@statusClass
                                    px-2
                                    py-1
                                    rounded-full
                                    text-[9px]
                                    font-bold
                                    uppercase
                                    whitespace-nowrap">

                                    @status

                                </span>

                            </div>

                        }

                    </div>

                }

            </div>



            <!-- ================================================= -->
            <!-- OPERATIONS NOTES -->
            <!-- ================================================= -->

            <div class="relative
                mt-8">


                <h3 class="text-[12px]
                    font-bold
                    text-on-surface
                    border-b
                    border-outline-variant
                    pb-1
                    mb-3
                    uppercase
                    flex items-center">


                    <span class="material-symbols-outlined
                        text-[16px]
                        mr-2">

                        info

                    </span>


                    Operations Summary

                </h3>


                <div class="space-y-2
                    text-[11px]
                    text-on-surface-variant">


                    <div class="flex justify-between">

                        <span>
                            Total Guests
                        </span>

                        <span class="font-bold text-on-surface">
                            @totalGuests
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span>
                            Confirmed Reservations
                        </span>

                        <span class="font-bold text-on-surface">
                            @confirmedCount
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span>
                            Pending Reservations
                        </span>

                        <span class="font-bold text-on-surface">
                            @pendingCount
                        </span>

                    </div>


                    <div class="flex justify-between">

                        <span>
                            Cancelled Reservations
                        </span>

                        <span class="font-bold text-on-surface">
                            @cancelledCount
                        </span>

                    </div>

                </div>

            </div>



            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <div class="relative
                mt-auto
                pt-8">


                <div class="border-t
                    border-outline-variant
                    pt-4
                    flex
                    justify-between
                    items-center">


                    <div>

                        <p class="text-[10px]
                            font-bold
                            text-primary
                            uppercase">

                            BistroPro

                        </p>


                        <p class="text-[9px]
                            text-on-surface-variant
                            mt-1">

                            Restaurant Management System

                        </p>

                    </div>


                    <div class="text-right">

                        <p class="text-[9px]
                            text-on-surface-variant">

                            Generated

                        </p>


                        <p class="text-[9px]
                            font-semibold
                            text-on-surface">

                            @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")

                        </p>

                    </div>

                </div>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- SHARE -->
        <!-- ===================================================== -->

        <div class="action-section">


            <button type="button"
                    onclick="shareReport()"
                    class="w-full
                flex
                items-center
                justify-center
                gap-2
                py-4
                mb-4
                border
                border-outline-variant
                bg-white
                rounded-xl
                text-on-surface-variant
                font-semibold
                hover:bg-surface-container-high
                active:scale-95
                transition-all">


                <span class="material-symbols-outlined">

                    share

                </span>


                Share Daily Brief

            </button>

        </div>

    </main>



    <!-- ========================================================= -->
    <!-- BOTTOM ACTION -->
    <!-- ========================================================= -->

    <div class="bottom-action
        fixed
        bottom-0
        left-0
        right-0
        p-4
        bg-surface-container-lowest
        border-t
        border-outline-variant
        z-50">


        <button type="button"
                onclick="window.print()"
                class="w-full
            flex
            items-center
            justify-center
            gap-3
            py-4
            bg-primary
            text-on-primary
            rounded-xl
            font-bold
            shadow-lg
            active:scale-98
            transition-all">


            <span class="material-symbols-outlined">

                print

            </span>


            Print Daily Brief

        </button>

    </div>



    <!-- ========================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>

            async function shareReport() {

                const shareData = {

                    title: 'BistroPro Daily Brief',

                    text:
                        'Daily restaurant report for @selectedDate.ToString("dddd, MMMM dd, yyyy")'

                };


                try {

                    if (navigator.share) {

                        await navigator.share(shareData);

                    }
                    else {

                        alert(
                            'Sharing is not supported on this browser.'
                        );

                    }

                }
                catch (error) {

                    console.log(error);

                }

            }

    </script>


</body>

</html>