@using Application.DTOs.Admins
@{
    @model TablesDto 
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Tables | BistroPro</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-secondary-fixed-variant": "#38485d",
                      "on-error": "#ffffff",
                      "surface-bright": "#fcf8ff",
                      "error-container": "#ffdad6",
                      "on-tertiary-fixed-variant": "#7b2f00",
                      "on-tertiary": "#ffffff",
                      "background": "#fcf8ff",
                      "surface-tint": "#4d44e3",
                      "on-secondary": "#ffffff",
                      "outline-variant": "#c7c4d8",
                      "on-primary-fixed": "#0f0069",
                      "tertiary-fixed-dim": "#ffb695",
                      "tertiary-fixed": "#ffdbcc",
                      "surface-container-low": "#f5f2ff",
                      "secondary-fixed-dim": "#b7c8e1",
                      "on-primary-fixed-variant": "#3323cc",
                      "on-error-container": "#93000a",
                      "tertiary": "#7e3000",
                      "surface-dim": "#dcd8e5",
                      "outline": "#777587",
                      "primary-fixed-dim": "#c3c0ff",
                      "on-tertiary-container": "#ffd2be",
                      "surface-container-high": "#eae6f4",
                      "on-primary": "#ffffff",
                      "on-secondary-container": "#54647a",
                      "surface-container-highest": "#e4e1ee",
                      "on-surface": "#1b1b24",
                      "tertiary-container": "#a44100",
                      "on-primary-container": "#dad7ff",
                      "surface": "#fcf8ff",
                      "on-background": "#1b1b24",
                      "surface-container": "#f0ecf9",
                      "on-surface-variant": "#464555",
                      "secondary-container": "#d0e1fb",
                      "error": "#ba1a1a",
                      "secondary": "#505f76",
                      "inverse-on-surface": "#f3effc",
                      "on-tertiary-fixed": "#351000",
                      "primary-fixed": "#e2dfff",
                      "inverse-primary": "#c3c0ff",
                      "surface-variant": "#e4e1ee",
                      "surface-container-lowest": "#ffffff"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "base": "8px",
                      "container-margin-desktop": "32px",
                      "sidebar-width": "280px",
                      "container-margin-mobile": "16px",
                      "gutter": "24px"
              },
              "fontFamily": {
                      "display-lg": ["Inter"],
                      "body-lg": ["Inter"],
                      "headline-lg": ["Inter"],
                      "headline-lg-mobile": ["Inter"],
                      "label-sm": ["Inter"],
                      "label-md": ["Inter"],
                      "body-md": ["Inter"],
                      "headline-md": ["Inter"]
              },
              "fontSize": {
                      "display-lg": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                      "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                      "headline-lg": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                      "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                      "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}],
                      "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                      "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                      "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}]
              }
            }
          }
        }
    </script>
    <style>
        body {
            background-color: #F9FAFB;
            font-family: 'Inter', sans-serif;
            color: #1b1b24;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }
        /* Custom scrollbar for sidebar */
        .sidebar-scroll::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-scroll::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-background overflow-x-hidden">
    <!-- SideNavBar -->
    <aside class="fixed left-0 top-0 h-screen w-sidebar-width bg-surface-container-low border-r border-outline-variant flex flex-col py-base gap-2 z-50">
        <!-- Brand Header -->
        <div class="px-6 py-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-white" data-icon="restaurant">restaurant</span>
            </div>
            <div>
                <h1 class="font-display-lg text-display-lg font-black text-primary leading-none">BistroPro</h1>
                <p class="font-label-md text-label-md text-on-surface-variant opacity-70">Downtown Branch</p>
            </div>
        </div>
        <!-- Navigation Tabs -->
        <nav class="flex-1 mt-6 px-3 flex flex-col gap-1 sidebar-scroll overflow-y-auto">
            <!-- Active state determined by current page "Tables" -->
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200 cursor-pointer active:scale-95" href="index">
                <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                <span class="font-label-md text-label-md">Dashboard</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200 cursor-pointer active:scale-95" href="reservations">
                <span class="material-symbols-outlined" data-icon="book_online">book_online</span>
                <span class="font-label-md text-label-md">Reservations</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg bg-secondary-container text-on-secondary-container border-l-4 border-primary font-bold transition-all duration-200 cursor-pointer active:scale-95" href="tables">
                <span class="material-symbols-outlined" data-icon="table_restaurant" style="font-variation-settings: 'FILL' 1;">table_restaurant</span>
                <span class="font-label-md text-label-md">Tables</span>
            </a>
            <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-highest transition-all duration-200 cursor-pointer active:scale-95" href="schedule">
                <span class="material-symbols-outlined" data-icon="calendar_month">calendar_month</span>
                <span class="font-label-md text-label-md">Schedule</span>
            </a>
        </nav>
        <!-- Sidebar CTA -->
        <div class="px-4 py-6">
            <button class="w-full py-3 px-4 bg-primary text-white rounded-xl font-bold flex items-center justify-center gap-2 hover:opacity-90 active:scale-95 transition-all shadow-sm">
                <span class="material-symbols-outlined" data-icon="add">add</span>
                <span class="font-label-md text-label-md">New Reservation</span>
            </button>
        </div>
    </aside>
    <!-- TopNavBar -->
    <header class="fixed top-0 right-0 left-0 ml-sidebar-width h-16 bg-surface border-b border-outline-variant flex justify-between items-center px-container-margin-desktop z-40">
        <div class="flex items-center flex-1 max-w-xl">
            <div class="relative w-full">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant" data-icon="search">search</span>
                <input class="w-full bg-surface-container-low border-none rounded-full pl-10 pr-4 py-2 text-body-md focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="Search tables or reservations..." type="text" />
            </div>
        </div>
        <div class="flex items-center gap-4">
            <button class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-surface-container-high transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined" data-icon="notifications">notifications</span>
            </button>
            <button class="w-10 h-10 rounded-full flex items-center justify-center hover:bg-surface-container-high transition-colors text-on-surface-variant">
                <span class="material-symbols-outlined" data-icon="settings">settings</span>
            </button>
            <div class="h-8 w-[1px] bg-outline-variant mx-2"></div>
            <div class="flex items-center gap-3 cursor-pointer group">
                <div class="text-right hidden lg:block">
                    <p class="font-label-md text-label-md font-bold text-on-surface">Alex Mercer</p>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">Floor Manager</p>
                </div>
                <img alt="Manager Profile" class="w-10 h-10 rounded-full object-cover border-2 border-primary-container" data-alt="A professional headshot of a floor manager with a confident and warm expression, wearing a dark navy corporate polo shirt. The background is a blurred, high-end modern restaurant interior with warm ambient lighting and soft wooden textures. The lighting is crisp and flattering, emphasizing a clean corporate SaaS aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuB6ziPFXPK__p1iBO-l_4JNx4vt1twidTNMexpejYvJotlLcd-ebQiMZTA-Ip2dPsSR9AGJPTrnbu40Wjv71Y-5uCw_vrAOhonSsnnuEWUCuxHFt_NF-caquK-ZNMPJrAbDRDvIzSRUNIfNFoEEH_RKCRq1XZGIJ_qmBqAz8WVaycbxVZaSgFSrRpsrWzai3nR9Zsyj1ZISnu9Vij0COzcwYlyrPO2Ly8pUi9S2imT3c7j5l3y5oGHgK9wNXPVospiPZ14DEWFxuXs" />
            </div>
        </div>
    </header>
    <!-- Main Content Canvas -->
    <main class="pt-24 pb-12 ml-sidebar-width px-container-margin-desktop min-h-screen">
        <!-- Header Actions -->
        <div class="flex justify-between items-end mb-8">
            <div>
                <h2 class="font-display-lg text-display-lg text-on-surface">Tables</h2>
            </div>
        </div>
        <!-- Dashboard Stats Row -->
        <div class="grid grid-cols-4 gap-gutter mb-8">
            <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-secondary-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined" data-icon="grid_view">grid_view</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total Tables</p>
                    <p class="font-headline-lg text-headline-lg text-on-surface">@Model.TotalTables<p>
                </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#E8F5E9] text-[#2E7D32] flex items-center justify-center">
                    <span class="material-symbols-outlined" data-icon="check_circle">check_circle</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Available</p>
                    <p class="font-headline-lg text-headline-lg text-[#2E7D32]">@Model.AvailableTables</p>
                </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#FFEBEE] text-[#C62828] flex items-center justify-center">
                    <span class="material-symbols-outlined" data-icon="event_busy">event_busy</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Occupied</p>
                    <p class="font-headline-lg text-headline-lg text-[#C62828]">@Model.OccupiedTables</p>
                </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-outline-variant shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-[#FFF8E1] text-[#F9A825] flex items-center justify-center">
                    <span class="material-symbols-outlined" data-icon="group">group</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total Capacity</p>
                    <p class="font-headline-lg text-headline-lg text-on-surface">@Model.TotalCapacity</p>
                </div>
            </div>
        </div>
        <!-- Tables Grid (Floor Plan View) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-6">
            <!-- Table Card Template (Available) -->
            @foreach (var item in Model.Tables!)
            {
                <div class="group bg-white rounded-xl border border-outline-variant p-6 shadow-sm hover:shadow-lg hover:border-primary transition-all duration-300 relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-[#2E7D32]"></div>
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            @if(item.IsAvailable)
                            {
                                <span class="px-2 py-1 bg-[#E8F5E9] text-[#2E7D32] text-label-sm font-bold rounded-full uppercase tracking-tighter">Available</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 bg-[#FFEBEE] text-[#C62828] text-label-sm font-bold rounded-full uppercase tracking-tighter">Reserved</span>
                            }
                        </div>
                        <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                            <a href="/admins/updateTable?id=@item.Id" class="p-1 hover:bg-surface-container-high rounded text-on-surface-variant transition-colors">
                                <span class="material-symbols-outlined text-[18px]" data-icon="edit">edit</span>
                            </a>
                            <a href="javascript:void(0)"
                               onclick="deleteTable(@item.Id)"
                               class="p-1 hover:bg-error-container hover:text-error rounded text-on-surface-variant transition-colors">

                                <span class="material-symbols-outlined text-[18px]">
                                    delete
                                </span>

                            </a>
                        </div>
                    </div>
                    <div class="text-center py-4">
                        <h3 class="font-display-lg text-[48px] text-on-surface leading-tight font-black">@item.TableNumber</h3>
                        <div class="flex items-center justify-center gap-2 text-on-surface-variant mt-2">
                            <span class="material-symbols-outlined text-[16px]" data-icon="person">person</span>
                            <span class="font-body-md text-body-md">Capacity: @item.Capacity</span>
                        </div>
                    </div>
                </div>
            }
            <!-- Empty slot for Adding a Table (Visual Indicator) -->
            <div class="flex flex-col items-center justify-center border-2 border-dashed border-outline-variant rounded-xl p-6 hover:bg-surface-container-low hover:border-primary transition-all cursor-pointer group">
                <div class="w-16 h-16 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant group-hover:bg-primary-container group-hover:text-white transition-colors">
                    <a href="AddNewTable" class="material-symbols-outlined text-[32px]" data-icon="add">add</a>
                </div>
                <p class="font-label-md text-label-md text-on-surface-variant group-hover:text-primary mt-4 font-bold">New Table</p>
            </div>
        </div>
    </main>
    <!-- Interactive Layer: Simple Toast for interaction feedback -->
    <div class="fixed bottom-8 right-8 bg-inverse-surface text-inverse-on-surface px-6 py-3 rounded-lg shadow-2xl translate-y-24 opacity-0 transition-all duration-300 flex items-center gap-3 z-[60]" id="toast">
        <span class="material-symbols-outlined text-green-400" data-icon="check">check</span>
        <span class="font-label-md text-label-md" id="toast-message">Action completed successfully</span>
    </div>
    <script>
        // Micro-interactions and Toast logic
        const toast = document.getElementById('toast');
        const toastMsg = document.getElementById('toast-message');

        function showToast(message) {
            toastMsg.innerText = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3000);
        }

        // Delete icon 
        async function deleteTable(tableId)
        {
            const confirmDelete = confirm("Are you sure you want to delete this table?");

            if (!confirmDelete)
                return;

            try
            {
                const response = await fetch(`/Admins/DeleteTable?tableId=${tableId}`, { method: "DELETE"});

                const result = await response.json();

                if (response.ok)
                {
                    alert(result.message);
                    location.reload();
                }
                else 
                {
                    alert(result.message);
                }   
            }
            catch
            {
                alert("Something went wrong.");
            }
        }


        // Add event listeners to buttons to show interactions
        document.querySelectorAll('button').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const action = btn.innerText.trim() || btn.querySelector('span')?.getAttribute('data-icon');
                if (action) {
                    showToast(`Clicked: ${action}`);
                }
            });
        });
    </script>
</body>
</html>