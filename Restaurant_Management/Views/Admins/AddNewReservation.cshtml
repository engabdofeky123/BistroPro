@using Application.DTOs.Admins
@model AddNewReservationDto
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed-variant": "#7b2f00",
                        "on-tertiary": "#ffffff",
                        "on-secondary": "#ffffff",
                        "background": "#fcf8ff",
                        "error": "#ba1a1a",
                        "tertiary-fixed-dim": "#ffb695",
                        "secondary": "#505f76",
                        "secondary-fixed-dim": "#b7c8e1",
                        "primary-fixed": "#e2dfff",
                        "on-secondary-fixed": "#0b1c30",
                        "inverse-primary": "#c3c0ff",
                        "tertiary-fixed": "#ffdbcc",
                        "on-surface": "#1b1b24",
                        "primary-fixed-dim": "#c3c0ff",
                        "on-tertiary-fixed": "#351000",
                        "outline-variant": "#c7c4d8",
                        "secondary-fixed": "#d3e4fe",
                        "primary-container": "#4f46e5",
                        "on-surface-variant": "#464555",
                        "on-error-container": "#93000a",
                        "inverse-on-surface": "#f3effc",
                        "surface-container-lowest": "#ffffff",
                        "on-primary": "#ffffff",
                        "surface": "#fcf8ff",
                        "on-secondary-fixed-variant": "#38485d",
                        "on-primary-fixed": "#0f0069",
                        "surface-dim": "#dcd8e5",
                        "tertiary-container": "#a44100",
                        "secondary-container": "#d0e1fb",
                        "on-error": "#ffffff",
                        "on-background": "#1b1b24",
                        "primary": "#3525cd",
                        "surface-variant": "#e4e1ee",
                        "tertiary": "#7e3000",
                        "on-secondary-container": "#54647a",
                        "surface-container-highest": "#e4e1ee",
                        "error-container": "#ffdad6",
                        "on-tertiary-container": "#ffd2be",
                        "surface-container-high": "#eae6f4",
                        "surface-tint": "#4d44e3",
                        "surface-container": "#f0ecf9",
                        "surface-container-low": "#f5f2ff",
                        "surface-bright": "#fcf8ff",
                        "outline": "#777587",
                        "inverse-surface": "#302f39",
                        "on-primary-fixed-variant": "#3323cc",
                        "on-primary-container": "#dad7ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "gutter": "24px",
                        "container-margin-mobile": "16px",
                        "sidebar-width": "280px",
                        "container-margin-desktop": "32px",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "label-md": ["Inter"],
                        "headline-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-sm": ["Inter"],
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "display-lg": ["Inter"]
                    },
                    "fontSize": {
                        "label-md": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "600"}],
                        "headline-md": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "headline-lg": ["24px", {"lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
                        "headline-lg-mobile": ["20px", {"lineHeight": "28px", "fontWeight": "600"}],
                        "label-sm": ["11px", {"lineHeight": "14px", "fontWeight": "500"}],
                        "body-md": ["14px", {"lineHeight": "20px", "fontWeight": "400"}],
                        "body-lg": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                        "display-lg": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}]
                    }
                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .form-input-focus:focus {
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2);
            border-color: #3525cd;
        }
    </style>
    <style>
        body {
          min-height: max(884px, 100dvh);
        }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">
    <!-- Top Navigation Anchor (Task Focused - Back button priority) -->
    <header class="sticky top-0 z-50 bg-surface h-16 flex items-center px-4 justify-between">
        <div class="flex items-center gap-4">
            <a href="/admins/reservations" class="p-2 hover:bg-surface-container-high rounded-full transition-colors active:scale-95">
                <span class="material-symbols-outlined text-on-surface">arrow_back</span>
            </a>
            <h1 class="font-headline-md text-headline-md font-bold text-on-surface">New Reservation</h1>
        </div>
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-on-surface-variant" data-icon="help">help</span>
        </div>
    </header>
    <main class="max-w-lg mx-auto p-4 pb-32">
        <section class="space-y-gutter">
            <!-- Header Card for Visual Context -->
            <div class="bg-white rounded-xl border border-outline-variant p-6 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-10">
                    <span class="material-symbols-outlined text-primary text-6xl" data-icon="restaurant_menu">restaurant_menu</span>
                </div>
                <h2 class="font-headline-md text-headline-md text-on-surface mb-1">Reservation Details</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">Configure customer and table information for the new booking.</p>
            </div>
            <!-- Main Form -->
            <form asp-action="SubmitAddNewReservation" method="post" class="space-y-6" id="reservationForm">
                @Html.AntiForgeryToken()
                <!-- Customer Name -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant" for="customerName">CUSTOMER NAME</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline" data-icon="person">person</span>
                        <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-lg text-body-lg form-input-focus outline-none transition-all placeholder:text-outline-variant" id="CustomerName" asp-for="CustomerName" value="@Model?.CustomerName" placeholder="Full name of the guest" type="text" />
                    </div>
                </div>
                <!-- Phone Number -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant" for="phoneNumber">PHONE NUMBER</label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline" data-icon="call">call</span>
                        <input class="w-full pl-10 pr-4 py-3 bg-white border border-outline-variant rounded-lg font-body-lg text-body-lg form-input-focus outline-none transition-all placeholder:text-outline-variant" id="CustomerPhone" asp-for="CustomerPhone" value="@Model?.CustomerPhone" placeholder="+1 (555) 000-0000" type="tel" />
                    </div>
                </div>
                <!-- Number of Guests (Stepper) -->
                <div class="bg-white rounded-xl border border-outline-variant p-4 flex items-center justify-between">
                    <div>
                        <label class="block font-label-md text-label-md text-on-surface-variant">
                            NUMBER OF GUESTS
                        </label>

                        <p class="font-body-md text-body-md text-outline" id="guestHint">
                            Standard seating table
                        </p>
                    </div>

                    <div class="flex items-center gap-4 bg-surface-container-low p-1 rounded-full border border-outline-variant">

                        <button type="button"
                                onclick="adjustGuests(-1)"
                                class="w-10 h-10 flex items-center justify-center bg-white rounded-full shadow-sm active:scale-90 transition-transform">
                            <span class="material-symbols-outlined text-primary">
                                remove
                            </span>
                        </button>

                        <!-- القيمة المعروضة -->
                        <span class="font-headline-md text-headline-md w-8 text-center"
                              id="guestCount">
                            @(Model?.NumberOfGuests > 0 ? Model.NumberOfGuests : 2)
                        </span>

                        <!-- القيمة التي سيتم إرسالها -->
                        <input asp-for="NumberOfGuests"
                               type="hidden"
                               id="NumberOfGuests"
                               value="@(Model?.NumberOfGuests > 0 ? Model.NumberOfGuests : 2)" />

                        <button type="button"
                                onclick="adjustGuests(1)"
                                class="w-10 h-10 flex items-center justify-center bg-white rounded-full shadow-sm active:scale-90 transition-transform">
                            <span class="material-symbols-outlined text-primary">
                                add
                            </span>
                        </button>

                    </div>
                </div>

                    <!-- DateTime Picker -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant"
                           for="ReservationDate">
                        DATE
                    </label>

                    <div class="relative">
                        <input class="w-full px-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md form-input-focus outline-none transition-all"
                               id="ReservationDate"
                               asp-for="ReservationDate"
                               type="date" />
                    </div>
                </div>

                <!-- Slot Selection -->
                <select  id="reservationSlot" name="ReservationSlotId"  
                        class="w-full pl-10 pr-10 py-3 bg-white border border-outline-variant rounded-lg font-body-lg text-body-lg form-input-focus outline-none transition-all appearance-none">
                    <option value="">Select a time slot</option>
                </select>


                <!-- Table Selection -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant"
                           asp-for="TableNumber">
                        TABLE SELECTION
                    </label>

                    <div class="relative">

                        <span class="absolute left-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline">
                            table_restaurant
                        </span>
                        
                        <select asp-for="TableNumber"
                                id="TableNumber"
                                class="w-full pl-10 pr-10 py-3 bg-white border border-outline-variant rounded-lg font-body-lg text-body-lg form-input-focus outline-none transition-all appearance-none">

                            <option value="">Select a Table</option>

                            @if (Model?.AvailableTables is not null)
                            {
                                @foreach (var table in Model.AvailableTables)
                                {
                                    <option value="@table.TableNumber">
                                        Table @table.TableNumber (@table.Capacity Seats)
                                    </option>
                                }
                            }
                            else 
                            {
                                <option value="1">
                                        Table 1 (Default)
                                    </option>
                            }
                        </select>

                        <span class="absolute right-3 top-1/2 -translate-y-1/2 material-symbols-outlined text-outline pointer-events-none">
                            expand_more
                        </span>

                    </div>

                    <span asp-validation-for="TableNumber"
                          class="text-sm text-red-600">
                    </span>
                </div>

                <!-- Additional Notes -->
                <div class="space-y-2">
                    <label class="block font-label-md text-label-md text-on-surface-variant" for="notes">SPECIAL REQUESTS / NOTES</label>
                    <textarea class="w-full px-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md form-input-focus outline-none transition-all resize-none" id="notes" placeholder="Birthday, allergies, preferred server..." rows="3" name="Notes">@Model?.Notes</textarea>
                </div>
            </form>
        </section>
    </main>
    <!-- Bottom Action Bar -->
    <footer class="fixed bottom-0 left-0 w-full bg-white border-t border-outline-variant p-4 px-gutter pb-8 z-50">
        <div class="max-w-lg mx-auto">
            <button class="w-full bg-primary py-4 rounded-xl flex items-center justify-center gap-2 group active:scale-98 transition-all shadow-lg shadow-primary/20" form="reservationForm" type="submit">
                <span class="text-on-primary font-headline-md text-headline-md font-bold">Confirm Reservation</span>
                <span class="material-symbols-outlined text-on-primary group-hover:translate-x-1 transition-transform" data-icon="arrow_forward">arrow_forward</span>
            </button>
            <p class="text-center mt-3 font-label-sm text-label-sm text-outline">By confirming, the guest will receive an SMS notification.</p>
        </div>
    </footer>
    <script>
        let guestCount = parseInt(document.getElementById("NumberOfGuests").value) || 1;

        const guestInput = document.getElementById("NumberOfGuests");

        document.getElementById("guestCount").innerText = guestCount;
        const countDisplay = document.getElementById('guestCount');
        const hintDisplay = document.getElementById('guestHint');

        function adjustGuests(amount) {

            guestCount = Math.max(1, Math.min(20, guestCount + amount));

            countDisplay.innerText = guestCount;
            guestInput.value = guestCount;
            guestInput.dispatchEvent(new Event("change"));

            if (guestCount <= 2)
                hintDisplay.innerText = "Cozy bistro table";
            else if (guestCount <= 4)
                hintDisplay.innerText = "Standard seating table";
            else if (guestCount <= 6)
                hintDisplay.innerText = "Large booth or joined tables";
            else
                hintDisplay.innerText = "Group reservation area";

            countDisplay.classList.add("scale-110", "text-primary");

            setTimeout(() => {
                countDisplay.classList.remove("scale-110", "text-primary");
            }, 100);
        }

        // Load available tables dynamically
                async function loadAvailableTables() {

            const reservationDate =
                document.getElementById("ReservationDate").value;

            const numberOfGuests =
                document.getElementById("NumberOfGuests").value;

            if (!reservationDate || !numberOfGuests)
                return;

            const response = await fetch(
                `/Admins/GetAvailableTablesForAddReservationForm?reservationDate=${reservationDate}&numberOfGuests=${numberOfGuests}`
            );

            if (!response.ok) {
                alert("Failed to load available tables");
                return;
            }

            const tables = await response.json();
            console.log(tables);

            const tableSelect =
                document.getElementById("TableNumber");

            tableSelect.innerHTML =
                '<option value="">Select Table</option>';

            tables.forEach(table => {

                tableSelect.innerHTML += `
                    <option value="${table.tableNumber}">
                        Table ${table.tableNumber} (${table.capacity} Seats)
                    </option>
                `;

            });
        }

        document.getElementById("ReservationDate")
            .addEventListener("change", loadAvailableTables);

        document.getElementById("NumberOfGuests")
            .addEventListener("change", loadAvailableTables);

        loadAvailableTables();


        // Slot Ajax call
            $.ajax({
                url: '/Reservations/slots',
                type: 'GET',
                dataType: 'json',

                success: function(slots) {

                    const slotSelect = $('#reservationSlot');

                    slotSelect.empty();

                    slotSelect.append(
                        '<option value="">Select a time slot</option>'
                    );

                    slots.forEach(function(slot) {

                        const option = $('<option></option>');

                        option.val(slot.id);

                        option.text(
                            `${formatTime(slot.startTime)} - ${formatTime(slot.endTime)}`
                        );

                        slotSelect.append(option);
                    });
                },

                error: function(xhr) {
                    console.error('Failed to load slots.', xhr);
                }
            });

            function formatTime(time) {

                const [hours, minutes] = time.split(':');

                const date = new Date();

                date.setHours(hours);
                date.setMinutes(minutes);
                date.setSeconds(0);

                return date.toLocaleTimeString([], {
                    hour: 'numeric',
                    minute: '2-digit'
                });
            }

    </script>
</body>
</html>