@using MVC.ViewModels.AuthVM
@model RegisterViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0,
    user-scalable=no, viewport-fit=cover" name="viewport" />

    <style>
            @@layer base {
                html,
                body {
                    width: 100vw;
                    margin: 0;
                    padding: 0;
                    background-color: #fcf8ff;
                }

                body {
                    overscroll-behavior: none;
                }

                .pb-safe {
                    padding-bottom: env(safe-area-inset-bottom, 0px);
                }

                .pt-safe {
                    padding-top: env(safe-area-inset-top, 0px);
                }

                main > :first-child {
                    margin-top: 0 !important;
                }

                main > :last-child {
                    margin-bottom: 0 !important;
                }
            }

            ::-webkit-scrollbar {
                display: none;
            }
    </style>

    <script src="https://cdn.tailwindcss.com"></script>

    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "on-surface": "#1b1b24",
                            "tertiary": "#7e3000",
                            "inverse-surface": "#302f39",
                            "surface-container-highest": "#e4e1ee",
                            "on-error-container": "#93000a",
                            "primary-container": "#4f46e5",
                            "on-tertiary-fixed": "#351000",
                            "primary-fixed-dim": "#c3c0ff",
                            "on-primary-fixed": "#0f0069",
                            "surface-container": "#f0ecf9",
                            "on-surface-variant": "#464555",
                            "tertiary-container": "#a44100",
                            "on-secondary": "#ffffff",
                            "outline-variant": "#c7c4d8",
                            "surface-container-low": "#f5f2ff",
                            "on-tertiary": "#ffffff",
                            "secondary": "#505f76",
                            "error-container": "#ffdad6",
                            "on-secondary-container": "#54647a",
                            "secondary-fixed-dim": "#b7c8e1",
                            "secondary-fixed": "#d3e4fe",
                            "surface-container-high": "#eae6f4",
                            "on-error": "#ffffff",
                            "outline": "#777587",
                            "surface-container-lowest": "#ffffff",
                            "surface-dim": "#dcd8e5",
                            "secondary-container": "#d0e1fb",
                            "surface-variant": "#e4e1ee",
                            "surface-bright": "#fcf8ff",
                            "on-primary-container": "#dad7ff",
                            "surface-tint": "#4d44e3",
                            "error": "#ba1a1a",
                            "primary-fixed": "#e2dfff",
                            "on-primary": "#ffffff",
                            "tertiary-fixed-dim": "#ffb695",
                            "on-primary-fixed-variant": "#3323cc",
                            "surface": "#fcf8ff",
                            "on-tertiary-fixed-variant": "#7b2f00",
                            "on-secondary-fixed": "#0b1c30",
                            "tertiary-fixed": "#ffdbcc",
                            "on-secondary-fixed-variant": "#38485d",
                            "background": "#fcf8ff",
                            "on-background": "#1b1b24"
                        },

                        borderRadius: {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                        },

                        spacing: {
                            "container-margin-desktop": "32px",
                            "base": "8px",
                            "container-margin-mobile": "16px",
                            "gutter": "24px",
                            "sidebar-width": "280px"
                        },

                        fontFamily: {
                            "headline-lg-mobile": ["Inter"],
                            "headline-md": ["Inter"],
                            "body-md": ["Inter"],
                            "headline-lg": ["Inter"],
                            "body-lg": ["Inter"],
                            "display-lg": ["Inter"],
                            "label-md": ["Inter"],
                            "label-sm": ["Inter"]
                        },

                        fontSize: {
                            "headline-lg-mobile": [
                                "20px",
                                {
                                    "lineHeight": "28px",
                                    "fontWeight": "600"
                                }
                            ],

                            "headline-md": [
                                "20px",
                                {
                                    "lineHeight": "28px",
                                    "fontWeight": "600"
                                }
                            ],

                            "body-md": [
                                "14px",
                                {
                                    "lineHeight": "20px",
                                    "fontWeight": "400"
                                }
                            ],

                            "headline-lg": [
                                "24px",
                                {
                                    "lineHeight": "32px",
                                    "letterSpacing": "-0.01em",
                                    "fontWeight": "600"
                                }
                            ],

                            "body-lg": [
                                "16px",
                                {
                                    "lineHeight": "24px",
                                    "fontWeight": "400"
                                }
                            ],

                            "display-lg": [
                                "36px",
                                {
                                    "lineHeight": "44px",
                                    "letterSpacing": "-0.02em",
                                    "fontWeight": "700"
                                }
                            ],

                            "label-md": [
                                "12px",
                                {
                                    "lineHeight": "16px",
                                    "letterSpacing": "0.05em",
                                    "fontWeight": "600"
                                }
                            ],

                            "label-sm": [
                                "11px",
                                {
                                    "lineHeight": "14px",
                                    "fontWeight": "500"
                                }
                            ]
                        }
                    }
                }
            };
    </script>

    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:
    opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />

    <!-- Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

</head>

<body class="bg-background font-body-md text-on-background">

    <!-- Header -->
    <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl
        pt-safe shadow-[0_1px_8px_rgba(0,0,0,0.04)]">

        <div class="h-14 px-container-margin-mobile flex items-center justify-between">

            <div class="flex items-center gap-base">

                <button type="button"
                        class="w-11 h-11 -ml-2 flex items-center justify-center
                    text-on-surface transition-active active:opacity-60"
                        onclick="history.back()">

                    <span class="material-symbols-outlined">
                        arrow_back
                    </span>

                </button>

                <span class="font-headline-md text-headline-md text-on-surface">
                    BistroPro
                </span>

            </div>

            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">

                <span class="material-symbols-outlined text-on-primary text-[18px]">
                    person
                </span>

            </div>

        </div>

    </header>


    <main class="pt-14 flex flex-col min-h-screen bg-surface">

        <div class="flex flex-col w-full h-full relative overflow-hidden bg-background">

            <!-- Background Decoration -->
            <div class="absolute inset-0 z-0 opacity-40 pointer-events-none
                flex justify-center items-center">

                <div class="w-full max-w-md h-full flex flex-col justify-between">

                    <div class="w-64 h-64 bg-primary/5 rounded-full blur-3xl
                        -ml-20 -mt-10">
                    </div>

                    <div class="w-72 h-72 bg-tertiary/5 rounded-full blur-3xl
                        self-end -mr-20 -mb-20">
                    </div>

                </div>

            </div>


            <div class="flex-1 overflow-y-auto z-10
                px-container-margin-mobile py-8
                flex flex-col items-center justify-center
                min-h-[calc(100vh-3.5rem)]">

                <div class="w-full max-w-sm flex flex-col
                    animate-[fadeInUp_0.5s_ease-out_forwards]">


                    <!-- Header -->
                    <div class="text-center mb-8 flex flex-col items-center">

                        <div class="w-16 h-16 bg-surface-container-high
                            rounded-2xl flex items-center justify-center
                            mb-6 shadow-sm rotate-3
                            hover:rotate-0 transition-transform duration-300">

                            <span class="material-symbols-outlined
                                text-primary text-3xl"
                                  style="font-variation-settings: 'FILL' 1;">

                                restaurant_menu

                            </span>

                        </div>

                        <h1 class="font-display-lg text-display-lg
                            text-on-background mb-2">

                            Create Account

                        </h1>

                        <p class="font-body-lg text-body-lg
                            text-on-surface-variant max-w-[280px]">

                            Join BistroPro for a premium dining experience.

                        </p>

                    </div>


                    <!-- Form Card -->
                    <div class="bg-surface-container-lowest
                        rounded-2xl p-6
                        shadow-[0_8px_30px_rgb(0,0,0,0.04)]
                        mb-8">

                        <form method="post" asp-action="Register"
                              asp-controller="Auth"
                              class="flex flex-col gap-5"
                              id="registrationForm">

                            @Html.AntiForgeryToken()


                            <!-- Server Errors -->
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="bg-error-container text-on-error-container
                                    rounded-xl p-4 text-sm">

                                    <div class="flex items-start gap-2">

                                        <span class="material-symbols-outlined text-[20px]">
                                            error
                                        </span>

                                        <div asp-validation-summary="All"></div>

                                    </div>

                                </div>
                            }


                            <!-- Full Name -->
                            <div class="flex flex-col gap-1.5 relative group">

                                <label asp-for="FullName"
                                       class="font-label-sm text-label-sm
                                    text-on-surface-variant
                                    uppercase tracking-wider ml-1">
                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-3.5
                                        text-on-surface-variant/50
                                        text-[20px]
                                        group-focus-within:text-primary
                                        transition-colors">
                                    </span>

                                    <input asp-for="FullName"
                                           class="w-full bg-surface-container-low
                                    text-on-surface font-body-md
                                    rounded-xl py-3.5 pl-11 pr-4
                                    outline-none
                                    focus:bg-surface-container-lowest
                                    focus:shadow-[0_0_0_2px_rgba(53,37,205,0.2)]
                                    focus:ring-0 transition-all
                                    placeholder:text-on-surface-variant/40"
                                           placeholder="John Doe" />

                                </div>

                                <span asp-validation-for="FullName"
                                      class="text-error text-xs ml-1">
                                </span>

                            </div>


                            <!-- Email -->
                            <div class="flex flex-col gap-1.5 relative group">

                                <label asp-for="Email"
                                       class="font-label-sm text-label-sm
                                    text-on-surface-variant
                                    uppercase tracking-wider ml-1">
                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-3.5
                                        text-on-surface-variant/50
                                        text-[20px]
                                        group-focus-within:text-primary
                                        transition-colors">
                                    </span>

                                    <input asp-for="Email"
                                           type="email"
                                           class="w-full bg-surface-container-low
                                    text-on-surface font-body-md
                                    rounded-xl py-3.5 pl-11 pr-4
                                    outline-none
                                    focus:bg-surface-container-lowest
                                    focus:shadow-[0_0_0_2px_rgba(53,37,205,0.2)]
                                    focus:ring-0 transition-all
                                    placeholder:text-on-surface-variant/40"
                                           placeholder="john@example.com" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-error text-xs ml-1">
                                </span>

                            </div>


                            <!-- Password -->
                            <div class="flex flex-col gap-1.5 relative group">

                                <label asp-for="Password"
                                       class="font-label-sm text-label-sm
                                    text-on-surface-variant
                                    uppercase tracking-wider ml-1">
                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-3.5
                                        text-on-surface-variant/50
                                        text-[20px]
                                        group-focus-within:text-primary
                                        transition-colors">
                                    </span>

                                    <input asp-for="Password"
                                           type="password"
                                           id="password"
                                           class="w-full bg-surface-container-low
                                    text-on-surface font-body-md
                                    rounded-xl py-3.5 pl-11 pr-12
                                    outline-none
                                    focus:bg-surface-container-lowest
                                    focus:shadow-[0_0_0_2px_rgba(53,37,205,0.2)]
                                    focus:ring-0 transition-all
                                    placeholder:text-on-surface-variant/40
                                    tracking-[0.2em] font-medium"
                                           placeholder="••••••••" />

                                    <button type="button"
                                            onclick="togglePassword('password', this)"
                                            class="absolute right-3 p-1.5
                                        text-on-surface-variant/50
                                        hover:text-on-surface
                                        transition-colors
                                        flex items-center justify-center
                                        rounded-lg
                                        hover:bg-surface-container">

                                        <span class="material-symbols-outlined text-[15px]">
                                            visibility_off
                                        </span>

                                    </button>

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-error text-xs ml-1">
                                </span>

                            </div>


                            <!-- Confirm Password -->
                            <div class="flex flex-col gap-1.5 relative group">

                                <label asp-for="ConfirmPassword"
                                       class="font-label-sm text-label-sm
                                    text-on-surface-variant
                                    uppercase tracking-wider ml-1">
                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-3.5
                                        text-on-surface-variant/50
                                        text-[20px]
                                        group-focus-within:text-primary
                                        transition-colors">
                                    </span>

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           id="confirmPassword"
                                           class="w-full bg-surface-container-low
                                    text-on-surface font-body-md
                                    rounded-xl py-3.5 pl-11 pr-12
                                    outline-none
                                    focus:bg-surface-container-lowest
                                    focus:shadow-[0_0_0_2px_rgba(53,37,205,0.2)]
                                    focus:ring-0 transition-all
                                    placeholder:text-on-surface-variant/40
                                    tracking-[0.2em] font-medium"
                                           placeholder="••••••••" />

                                    <button type="button"
                                            onclick="togglePassword('confirmPassword', this)"
                                            class="absolute right-3 p-1.5
                                        text-on-surface-variant/50
                                        hover:text-on-surface
                                        transition-colors
                                        flex items-center justify-center
                                        rounded-lg
                                        hover:bg-surface-container">

                                        <span class="material-symbols-outlined text-[15px]">
                                            visibility_off
                                        </span>

                                    </button>

                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-error text-xs ml-1">
                                </span>

                            </div>


                            <!-- Terms -->
                            <label class="flex items-start gap-3 mt-2 cursor-pointer group">

                                <div class="relative flex items-center justify-center mt-0.5">

                                    <input asp-for="ConfirmOurTerms"
                                           type="checkbox"
                                           class="peer sr-only" />

                                    <div class="w-5 h-5 rounded-[6px]
                                        bg-surface-container-low
                                        border border-outline-variant
                                        peer-checked:bg-primary
                                        peer-checked:border-primary
                                        transition-all duration-200
                                        flex items-center justify-center
                                        shadow-inner
                                        group-hover:shadow-[0_0_0_2px_rgba(53,37,205,0.1)]">

                                    </div>

                                </div>

                                <span class="font-body-md text-body-md
                                    text-on-surface-variant
                                    flex-1 leading-relaxed">

                                    I agree to the

                                    <a class="text-primary font-medium hover:underline"
                                       href="#">
                                        Terms and Conditions
                                    </a>

                                    and

                                    <a class="text-primary font-medium hover:underline"
                                       href="#">
                                        Privacy Policy
                                    </a>.

                                </span>

                            </label>

                            <span asp-validation-for="ConfirmOurTerms"
                                  class="text-error text-xs ml-1">
                            </span>


                            <!-- Submit -->
                            <button class="mt-4 w-full bg-primary text-on-primary
                                font-label-md text-label-md py-4 rounded-xl
                                shadow-[0_4px_12px_rgba(79,70,229,0.25)]
                                hover:shadow-[0_6px_16px_rgba(79,70,229,0.35)]
                                hover:-translate-y-0.5 transition-all duration-200
                                active:translate-y-0 active:shadow-none
                                flex items-center justify-center gap-2
                                group overflow-hidden relative"
                                    type="submit">

                                <div class="absolute inset-0 bg-white/20
                                    translate-y-full group-hover:translate-y-0
                                    transition-transform duration-300 ease-out">
                                </div>

                                <span class="relative z-10 tracking-widest uppercase">
                                    Create Account
                                </span>

                                <!-- FIXED ARROW -->
                                <span class="material-symbols-outlined
                                    relative z-10 text-[18px]
                                    group-hover:translate-x-1
                                    transition-transform">

                                    arrow_forward

                                </span>

                            </button>

                        </form>

                    </div>


                    <!-- Footer -->
                    <div class="text-center pb-8">

                        <span class="font-body-md text-body-md text-on-surface-variant">
                            Already have an account?
                        </span>

                        <a asp-action="Login"
                           asp-controller="Auth"
                           class="font-label-md text-label-md text-primary
                            hover:text-primary-container
                            transition-colors uppercase
                            tracking-wider ml-1
                            hover:underline">

                            Sign In

                        </a>

                    </div>

                </div>

            </div>


            <style>

                            @@keyframes fadeInUp {

                                from {
                                    opacity: 0;
                                    transform: translateY(20px);
                                }

                                to {
                                    opacity: 1;
                                    transform: translateY(0);
                                }
                            }

            </style>


            <script>

                            function togglePassword(inputId, btn) {

                                const input = document.getElementById(inputId);

                                const icon = btn.querySelector('span');

                                if (input.type === 'password') {

                                    input.type = 'text';

                                    icon.textContent = 'visibility';

                                    input.classList.remove(
                                        'tracking-[0.2em]',
                                        'font-medium'
                                    );

                                }
                                else {

                                    input.type = 'password';

                                    icon.textContent = 'visibility_off';

                                    input.classList.add(
                                        'tracking-[0.2em]',
                                        'font-medium'
                                    );

                                }

                            }

            </script>

        </div>

    </main>

</body>

</html>