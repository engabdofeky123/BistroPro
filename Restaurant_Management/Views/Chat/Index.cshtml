@{
    ViewData["Title"] = "Customer Support";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-dark text-white d-flex align-items-center">

                    <div class="me-3 fs-3">
                        🤖
                    </div>

                    <div>
                        <h5 class="mb-0">Restaurant AI Support</h5>
                        <small class="text-light">
                            Ask anything about reservations, menu or orders.
                        </small>
                    </div>

                </div>

                <div class="card-body p-0">

                    <div id="chatBox">

                        <div class="message bot-message">
                            👋 Hello! <br />
                            Welcome to our restaurant. <br />
                            How can I help you today?
                        </div>

                    </div>

                    <div class="border-top p-3">

                        <div class="input-group">

                            <input id="messageInput"
                                   type="text"
                                   class="form-control"
                                   placeholder="Type your message..." />

                            <button class="btn btn-success"
                                    id="sendBtn">
                                Send
                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    body {
        background: #f5f5f5;
    }

    #chatBox {
        height: 550px;
        overflow-y: auto;
        padding: 20px;
        background: #fafafa;
    }

    .message {
        max-width: 75%;
        padding: 12px 18px;
        margin-bottom: 15px;
        border-radius: 18px;
        word-wrap: break-word;
        clear: both;
    }

    .user-message {
        background: #198754;
        color: white;
        margin-left: auto;
        border-bottom-right-radius: 5px;
        float: right;
    }

    .bot-message {
        background: white;
        border: 1px solid #ddd;
        margin-right: auto;
        border-bottom-left-radius: 5px;
        float: left;
    }

</style>

@section Scripts
{
<script>

    const chatBox = document.getElementById("chatBox");
    const input = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");

    const sessionId = crypto.randomUUID();

    sendBtn.addEventListener("click", sendMessage);

    input.addEventListener("keypress", function (e) {

        if (e.key === "Enter") {
            sendMessage();
        }

    });

    async function sendMessage() {

        const message = input.value.trim();

        if (message === "")
            return;

        addUserMessage(message);

        input.value = "";

        addTyping();

        try {

            const response = await fetch("https://localhost:7155/chat/SendMessage", {

                method: "POST",

                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },

                body: new URLSearchParams({

                    message: message,
                    sessionId: sessionId

                })

            });

            const data = await response.json();

            removeTyping();

            if (data.success) {

                addBotMessage(data.reply);

            } else {

                addBotMessage("Sorry, something went wrong.");

            }

        }
        catch (error) {

            removeTyping();

            addBotMessage("Unable to connect to AI Support.");

            console.error(error);

        }

    }

    function addUserMessage(text) {

        chatBox.innerHTML += `
            <div class="message user-message">
                ${text}
            </div>`;

        scrollBottom();

    }

    function addBotMessage(text) {

        chatBox.innerHTML += `
            <div class="message bot-message">
                ${text}
            </div>`;

        scrollBottom();

    }

    function addTyping() {

        chatBox.innerHTML += `
            <div class="message bot-message" id="typing">
                🤖 Typing...
            </div>`;

        scrollBottom();

    }

    function removeTyping() {

        const typing = document.getElementById("typing");

        if (typing) {
            typing.remove();
        }

    }

    function scrollBottom() {

        chatBox.scrollTop = chatBox.scrollHeight;

    }

</script>
}