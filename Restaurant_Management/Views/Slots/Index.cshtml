@using Application.DTOs.ReservationsSlots
@model List<ReservationSlotDto>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reservation Slots | BistroPro</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700&display=swap"
          rel="stylesheet" />

    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            "primary": "#3525cd",
                            "secondary": "#505f76",
                            "background": "#fcf8ff",
                            "surface": "#fcf8ff",
                            "surface-container-low": "#f5f2ff",
                            "surface-container": "#f0ecf9",
                            "surface-container-high": "#eae6f4",
                            "surface-container-highest": "#e4e1ee",
                            "surface-container-lowest": "#ffffff",
                            "on-surface": "#1b1b24",
                            "on-surface-variant": "#464555",
                            "outline": "#777587",
                            "outline-variant": "#c7c4d8",
                            "error": "#ba1a1a",
                            "error-container": "#ffdad6"
                        },

                        borderRadius: {
                            DEFAULT: "0.25rem",
                            lg: "0.5rem",
                            xl: "0.75rem",
                            full: "9999px"
                        },

                        spacing: {
                            base: "8px",
                            "sidebar-width": "280px",
                            "container-margin-desktop": "32px",
                            gutter: "24px"
                        },

                        fontFamily: {
                            display: ["Inter"],
                            body: ["Inter"]
                        }
                    }
                }
            };
    </script>

    <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }

            body {
                font-family: 'Inter', sans-serif;
            }
    </style>
</head>

<body class="bg-background text-on-surface">

    <!-- ================= SIDEBAR ================= -->

    <aside class="fixed left-0 top-0 h-screen w-sidebar-width
        bg-surface-container-low
        border-r border-outline-variant
        flex flex-col py-base
        z-50">

        <!-- Logo -->

        <div class="px-6 py-4 flex items-center gap-3">

            <div class="w-10 h-10 rounded-lg bg-primary
                flex items-center justify-center text-white">

                <span class="material-symbols-outlined">
                    restaurant_menu
                </span>

            </div>

            <div>

                <h1 class="text-2xl font-black text-primary">
                    BistroPro
                </h1>

                <p class="text-xs text-on-surface-variant opacity-70">
                    Downtown Branch
                </p>

            </div>

        </div>


        <!-- Navigation -->

        <nav class="flex-1 mt-4 px-3 flex flex-col gap-1">

            <a href="/Admins"
               class="flex items-center gap-3 px-4 py-3 rounded-lg
                text-on-surface-variant
                hover:bg-surface-container-highest
                transition">

                <span class="material-symbols-outlined">
                    dashboard
                </span>

                <span>
                    Dashboard
                </span>

            </a>


            <a href="/Admins/Reservations"
               class="flex items-center gap-3 px-4 py-3 rounded-lg
                text-on-surface-variant
                hover:bg-surface-container-highest
                transition">

                <span class="material-symbols-outlined">
                    book_online
                </span>

                <span>
                    Reservations
                </span>

            </a>


            <a href="/Admins/Tables"
               class="flex items-center gap-3 px-4 py-3 rounded-lg
                text-on-surface-variant
                hover:bg-surface-container-highest
                transition">

                <span class="material-symbols-outlined">
                    table_restaurant
                </span>

                <span>
                    Tables
                </span>

            </a>


            <!-- ACTIVE -->

            <a href="/Slots"
               class="flex items-center gap-3 px-4 py-3 rounded-lg
                bg-secondary-container
                text-on-secondary-container
                border-l-4 border-primary
                font-bold shadow-sm">

                <span class="material-symbols-outlined">
                    schedule
                </span>

                <span>
                    Reservation Slots
                </span>

            </a>


            <a href="/Admins/Schedule"
               class="flex items-center gap-3 px-4 py-3 rounded-lg
                text-on-surface-variant
                hover:bg-surface-container-highest
                transition">

                <span class="material-symbols-outlined">
                    calendar_month
                </span>

                <span>
                    Schedule
                </span>

            </a>

        </nav>

    </aside>


    <!-- ================= TOP NAV ================= -->

    <header class="fixed top-0 right-0 left-sidebar-width
        h-16 px-container-margin-desktop
        bg-surface
        border-b border-outline-variant
        flex justify-between items-center
        z-40">

        <div>

            <h2 class="font-semibold">
                Reservation Management
            </h2>

            <p class="text-xs text-on-surface-variant">
                Manage reservation time slots
            </p>

        </div>


        <div class="flex items-center gap-4">

            <button class="p-2 text-on-surface-variant
                hover:bg-surface-container-high
                rounded-full">

                <span class="material-symbols-outlined">
                    notifications
                </span>

            </button>


            <div class="h-8 w-[1px] bg-outline-variant"></div>


            <div class="text-right">

                <p class="text-sm font-bold">
                    Alex Rivera
                </p>

                <p class="text-[10px]
                    text-on-surface-variant
                    uppercase">
                    Manager
                </p>

            </div>

        </div>

    </header>


    <!-- ================= MAIN ================= -->

    <main class="ml-sidebar-width pt-16 min-h-screen">

        <div class="p-container-margin-desktop
            max-w-[1440px]
            mx-auto">

            <!-- ================= PAGE HEADER ================= -->

            <div class="flex flex-col md:flex-row
                md:items-end
                justify-between
                mb-8
                gap-4">

                <div>

                    <h1 class="text-3xl font-bold">
                        Reservation Slots
                    </h1>

                    <p class="text-sm text-on-surface-variant mt-1">
                        Manage the available reservation time slots
                        for your restaurant.
                    </p>

                </div>


                <!-- ADD NEW SLOT -->

                <a href="/Slots/Create"
                   class="px-5 py-2.5
                    bg-primary
                    text-white
                    rounded-lg
                    flex items-center
                    gap-2
                    font-bold
                    shadow-lg
                    hover:shadow-primary/20
                    hover:opacity-95
                    transition">

                    <span class="material-symbols-outlined">
                        add
                    </span>

                    Add New Slot

                </a>

            </div>


            <!-- ================= SUMMARY ================= -->

            <div class="grid grid-cols-1
                md:grid-cols-3
                gap-gutter
                mb-8">

                <!-- TOTAL -->

                <div class="bg-surface-container-lowest
                    border border-outline-variant
                    p-5
                    rounded-xl
                    shadow-sm">

                    <div class="flex items-center
                        justify-between">

                        <div>

                            <p class="text-xs
                                text-on-surface-variant
                                uppercase
                                font-semibold">

                                Total Slots

                            </p>

                            <p class="text-3xl
                                font-bold
                                mt-1">

                                @Model.Count()

                            </p>

                        </div>

                        <div class="w-11 h-11
                            rounded-lg
                            bg-primary/10
                            text-primary
                            flex items-center
                            justify-center">

                            <span class="material-symbols-outlined">
                                schedule
                            </span>

                        </div>

                    </div>

                </div>


                <!-- ACTIVE -->

                <div class="bg-surface-container-lowest
                    border border-outline-variant
                    p-5
                    rounded-xl
                    shadow-sm">

                    <div class="flex items-center
                        justify-between">

                        <div>

                            <p class="text-xs
                                text-on-surface-variant
                                uppercase
                                font-semibold">

                                Active Slots

                            </p>

                            <p class="text-3xl
                                font-bold
                                mt-1">

                                @Model.Count(x => x.IsActive)

                            </p>

                        </div>

                        <div class="w-11 h-11
                            rounded-lg
                            bg-green-100
                            text-green-700
                            flex items-center
                            justify-center">

                            <span class="material-symbols-outlined">
                                check_circle
                            </span>

                        </div>

                    </div>

                </div>


                <!-- INACTIVE -->

                <div class="bg-surface-container-lowest
                    border border-outline-variant
                    p-5
                    rounded-xl
                    shadow-sm">

                    <div class="flex items-center
                        justify-between">

                        <div>

                            <p class="text-xs
                                text-on-surface-variant
                                uppercase
                                font-semibold">

                                Inactive Slots

                            </p>

                            <p class="text-3xl
                                font-bold
                                mt-1">

                                @Model.Count(x => !x.IsActive)

                            </p>

                        </div>

                        <div class="w-11 h-11
                            rounded-lg
                            bg-red-100
                            text-red-700
                            flex items-center
                            justify-center">

                            <span class="material-symbols-outlined">
                                block
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= TABLE ================= -->

            <div class="bg-surface-container-lowest
                border border-outline-variant
                rounded-xl
                shadow-sm
                overflow-hidden">

                <!-- TABLE HEADER -->

                <div class="p-5
                    border-b border-outline-variant
                    flex items-center
                    justify-between
                    bg-surface-container-low/50">

                    <div>

                        <h3 class="text-xl font-semibold">
                            All Reservation Slots
                        </h3>

                        <p class="text-xs
                            text-on-surface-variant
                            mt-1">

                            Manage your restaurant's booking schedule.

                        </p>

                    </div>

                    <span class="text-xs
                        text-on-surface-variant">

                        @Model.Count() slots

                    </span>

                </div>


                <!-- TABLE -->

                <div>

                    <table class="w-full text-left">

                        <thead>

                            <tr class="bg-surface-container-low
                                border-b border-outline-variant">

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase">

                                    #

                                </th>

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase">

                                    Start Time

                                </th>

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase">

                                    End Time

                                </th>

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase">

                                    Duration

                                </th>

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase">

                                    Status

                                </th>

                                <th class="px-6 py-4
                                    text-xs
                                    text-on-surface-variant
                                    uppercase
                                    text-right">

                                    Actions

                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-outline-variant">

                            @if (!Model.Any())
                            {
                                <tr>

                                    <td colspan="6"
                                        class="px-6 py-12
                                        text-center">

                                        <div class="flex flex-col
                                            items-center
                                            gap-3">

                                            <span class="material-symbols-outlined
                                                text-5xl
                                                text-outline">

                                                schedule

                                            </span>

                                            <p class="font-semibold">
                                                No reservation slots found
                                            </p>

                                            <p class="text-sm
                                                text-on-surface-variant">

                                                Create your first reservation
                                                slot to get started.

                                            </p>

                                            <a href="/Slots/Create"
                                               class="mt-2
                                                px-4 py-2
                                                bg-primary
                                                text-white
                                                rounded-lg
                                                text-sm
                                                font-semibold">

                                                Add New Slot

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                            else
                            {
                                @foreach (var slot in Model.OrderBy(x => x.StartTime))
                                {
                                    var duration = slot.EndTime - slot.StartTime;

                                    <tr class="hover:bg-surface-container-low
                                        transition-colors">

                                        <!-- ID -->

                                        <td class="px-6 py-4">

                                            <span class="text-sm
                                                font-semibold
                                                text-on-surface-variant">

                                                #@slot.Id

                                            </span>

                                        </td>


                                        <!-- START -->

                                        <td class="px-6 py-4">

                                            <div class="flex items-center gap-3">

                                                <div class="w-9 h-9
                                                    rounded-lg
                                                    bg-primary/10
                                                    text-primary
                                                    flex items-center
                                                    justify-center">

                                                    <span class="material-symbols-outlined">
                                                        schedule
                                                    </span>

                                                </div>

                                                <span class="font-bold">

                                                        @(
                                                            DateTime.Today.Add(slot.StartTime).ToString("hh:mm tt")
                                                        )

                                                </span>

                                            </div>

                                        </td>


                                        <!-- END -->

                                        <td class="px-6 py-4">

                                            <span class="font-bold">

                                                    @(
                                                        DateTime.Today.Add(slot.EndTime).ToString("hh:mm tt")
                                                    )

                                            </span>

                                        </td>


                                        <!-- DURATION -->

                                        <td class="px-6 py-4">

                                            <span class="px-3 py-1.5
                                                rounded-lg
                                                bg-surface-container-high
                                                text-xs
                                                font-bold">

                                                @duration.TotalMinutes.ToString("0") min

                                            </span>

                                        </td>


                                        <!-- STATUS -->

                                        <td class="px-6 py-4">

                                            @if (slot.IsActive)
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    gap-1.5
                                                    px-3 py-1.5
                                                    rounded-full
                                                    bg-green-100
                                                    text-green-800
                                                    text-xs
                                                    font-bold">

                                                    <span class="w-2 h-2
                                                        rounded-full
                                                        bg-green-500">
                                                    </span>

                                                    Active

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    gap-1.5
                                                    px-3 py-1.5
                                                    rounded-full
                                                    bg-red-100
                                                    text-red-800
                                                    text-xs
                                                    font-bold">

                                                    <span class="w-2 h-2
                                                        rounded-full
                                                        bg-red-500">
                                                    </span>

                                                    Inactive

                                                </span>
                                            }

                                        </td>


                                        <!-- ACTIONS -->

                                        <td class="px-6 py-4">

                                            <div class="flex justify-end
                                                items-center
                                                gap-2">

                                                <!-- EDIT -->

                                                <a href="/Slots/Edit/@slot.Id"
                                                   class="p-2
                                                    text-secondary
                                                    hover:bg-secondary-container
                                                    rounded-lg
                                                    transition"
                                                   title="Edit">

                                                    <span class="material-symbols-outlined">
                                                        edit
                                                    </span>

                                                </a>


                                                <!-- DELETE -->

                                                <button type="button"
                                                        onclick="deleteSlot(@slot.Id)"
                                                        class="p-2
                                                    text-error
                                                    hover:bg-error-container
                                                    rounded-lg
                                                    transition"
                                                        title="Delete">

                                                    <span class="material-symbols-outlined">
                                                        delete
                                                    </span>

                                                </button>

                                            </div>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

            function deleteSlot(id) {

                const confirmed = confirm(
                    "Are you sure you want to delete this reservation slot?"
                );

                if (!confirmed)
                    return;

                fetch(`/Slots/Delete/${id}`, {
                    method: "DELETE"
                })
                    .then(response => {

                        if (!response.ok)
                            throw new Error("Failed to delete slot.");

                        return response.json();

                    })
                    .then(data => {

                        alert(
                            data.message ||
                            "Reservation slot deleted successfully."
                        );

                        location.reload();

                    })
                    .catch(error => {

                        console.error(error);

                        alert(
                            "Failed to delete reservation slot."
                        );

                    });

            }

    </script>

</body>

</html>